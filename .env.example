# Copy to .env and set your own values. .env is ignored by Git; never commit real passwords or keys.
#   cp .env.example .env
# The same variable names are used in production; there they are written to the server's .env by the deploy job
# from GitHub Environment secrets. ASP.NET Core reads "Section__Key" as configuration "Section:Key".

########################################################################################################################
# Database (unchanged from the DB project)
########################################################################################################################
# Superuser of the PostgreSQL container. Used only by the container itself and by
# db/security/bootstrap.sql on first start; no service connects with it.
POSTGRES_PASSWORD=

# Login roles created by db/security/bootstrap.sql
#   app_admin       owner of the schema, used by the migrator
#   oneloaf_app     application services (role app_write)
#   oneloaf_reader  reporting (role app_read)
ONELOAF_ADMIN_PASSWORD=
ONELOAF_APP_PASSWORD=
ONELOAF_READER_PASSWORD=

# Database name and host port
ONELOAF_DB=oneloaf
POSTGRES_PORT=5432

# Host ports of the other local containers
CORE_API_PORT=5080
ASSISTANT_PORT=5081
NOTIFICATION_PORT=5082
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
REDIS_PORT=6379

########################################################################################################################
# Common to all services
########################################################################################################################
ASPNETCORE_ENVIRONMENT=Development
# Services connect as oneloaf_app (never as app_admin or postgres). docker-compose builds the string from the values above:
#   ConnectionStrings__OneLoaf=Host=db;Port=5432;Database=oneloaf;Username=oneloaf_app;Password=${ONELOAF_APP_PASSWORD}

# RabbitMQ
RABBITMQ_DEFAULT_USER=oneloaf
RABBITMQ_DEFAULT_PASS=
# The services get RabbitMq__UserName/Password from RABBITMQ_DEFAULT_USER/PASS (docker-compose.yml)
RabbitMq__Host=rabbitmq
RabbitMq__Port=5672
RabbitMq__VirtualHost=/
RabbitMq__Exchange=oneloaf.events

# Redis
REDIS_PASSWORD=
# Redis__ConnectionString=redis:6379,password=${REDIS_PASSWORD}

# JWT (RS256). Generate once:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.key && openssl pkey -in jwt.key -pubout -out jwt.pub
# Put the PEM contents (with \n line breaks) here. The private key is given ONLY to the Core API.
Jwt__Issuer=https://localhost/core
Jwt__Audience=oneloaf
Jwt__AccessTokenMinutes=60
# A sign-in is continued with a rotating refresh token (HttpOnly cookie) for this many days without use.
Jwt__RefreshTokenDays=30
Jwt__SigningKeyPem=
Jwt__PublicKeyPem=

# CORS: origins of the Blazor app (comma-separated). Locally the client runs on http://localhost:5090;
# in production the client and the APIs share one origin behind Caddy.
Cors__AllowedOrigins=http://localhost:5090

# Logging / observability
Serilog__MinimumLevel__Default=Information
Loki__Url=http://loki:3100
OTEL_EXPORTER_OTLP_ENDPOINT=

########################################################################################################################
# Core API
########################################################################################################################
CoreApi__PublicBaseUrl=https://localhost/core

########################################################################################################################
# AI Assistant
########################################################################################################################
Anthropic__ApiKey=
Anthropic__Model=claude-haiku-4-5
Anthropic__MaxTokens=1024
Anthropic__TimeoutSeconds=30
# Prices per million tokens for cost accounting (update if the model changes)
Assistant__Pricing__InputPerMTok=1.00
Assistant__Pricing__OutputPerMTok=5.00
Assistant__Pricing__CacheReadPerMTok=0.10
Assistant__DailyRequestLimit=50
Assistant__DailyTokenLimit=200000
Assistant__MonthlyBudgetUsd=4.5
Assistant__MaxToolRounds=6
# Internal URL of the Core API as seen from the assistant container
Assistant__CoreApiBaseUrl=http://core-api:8080

########################################################################################################################
# Notification
########################################################################################################################
# Web Push VAPID keys. Generate once (e.g. npx web-push generate-vapid-keys) and keep the private key secret.
Notification__VapidSubject=mailto:admin@example.com
Notification__VapidPublicKey=
Notification__VapidPrivateKey=
Notification__SchedulerIntervalSeconds=30
Notification__MaxAttempts=5
Smtp__Host=
Smtp__Port=587
Smtp__User=
Smtp__Password=
Smtp__From=OneLoaf <no-reply@example.com>

########################################################################################################################
# Production only (deploy/docker-compose.prod.yml)
########################################################################################################################
# Public host name served by Caddy (the HTTPS certificate is issued for it) and the contact e-mail for Let's Encrypt
DOMAIN=
ACME_EMAIL=
# Lower-case owner of the GHCR images (ghcr.io/<owner>/oneloaf-*) and the tag to run
GHCR_OWNER=
IMAGE_TAG=latest
BACKUP_KEEP_DAYS=14

# Observability stack. GRAFANA_BASIC_AUTH_HASH: docker run --rm caddy:2-alpine caddy hash-password
GRAFANA_ADMIN_PASSWORD=
GRAFANA_BASIC_AUTH_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
