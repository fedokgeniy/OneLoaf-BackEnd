@* OneLoaf wordmark: "One L♥af" with the heart of the logo; accessible name "OneLoaf". *@
<span class="brand @Class" role="img" aria-label="OneLoaf">
    <span aria-hidden="true">One&nbsp;L</span><svg class="@(OnDark ? "brand__heart brand__heart--on-dark" : "brand__heart")" viewBox="0 0 20 18" aria-hidden="true" focusable="false"><path d="M10 16.8C10 16.8 1.2 10.6 1.2 5.4 1.2 2.5 3.5 1 6 1 7.9 1 9.3 2.1 10 3.6 10.7 2.1 12.1 1 14 1 16.5 1 18.8 2.5 18.8 5.4 18.8 10.6 10 16.8 10 16.8Z" /></svg><span aria-hidden="true">af</span>
</span>

@code {
    /// <summary>On the espresso background: blush heart instead of terra.</summary>
    [Parameter] public bool OnDark { get; set; }

    /// <summary>Extra class (size, spacing).</summary>
    [Parameter] public string? Class { get; set; }
}
