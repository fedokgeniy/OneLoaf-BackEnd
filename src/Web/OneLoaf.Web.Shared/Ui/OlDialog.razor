@* Dialog (.ol-dialog) on the native <dialog> element opened with showModal(): the browser traps focus, makes the page
   behind inert, closes on Esc and returns focus to the opener. Bottom sheet on phones, centred from tablet up. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<dialog class="ol-dialog ol-native-dialog" aria-labelledby="@TitleId" @ref="_element" @onclose="OnNativeClose">
    @if (Open)
    {
        <div class="ol-dialog__handle" aria-hidden="true"></div>
        <div class="ol-dialog__head">
            <h2 class="ol-dialog__title" id="@TitleId">@Title</h2>
            <button type="button" class="ol-icon-btn" aria-label="Close" @onclick="CloseAsync"><OlIcon Name="IconName.Close" /></button>
        </div>
        <div class="ol-dialog__body">@ChildContent</div>
        @if (Footer is not null)
        {
            <div class="ol-dialog__foot">@Footer</div>
        }
    }
</dialog>

@code {
    private readonly string _id = ElementIds.Next("dialog");
    private ElementReference _element;
    private IJSObjectReference? _module;
    private bool _shown;

    /// <summary>Open state.</summary>
    [Parameter] public bool Open { get; set; }

    /// <summary>Raised when the dialog closes (close button, Esc).</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Heading.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Body.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Buttons at the bottom; the primary action last.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    private string TitleId => _id + "-title";

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open == _shown)
        {
            return;
        }

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/OneLoaf.Web.Shared/ol-dialog.js");
        _shown = Open;
        await _module.InvokeVoidAsync(Open ? "open" : "close", _element);
    }

    private async Task CloseAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("close", _element);
        }

        _shown = false;
        await OnClose.InvokeAsync();
    }

    private async Task OnNativeClose()
    {
        if (_shown)
        {
            _shown = false;
            await OnClose.InvokeAsync();
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Page is closing.
            }
        }
    }
}
