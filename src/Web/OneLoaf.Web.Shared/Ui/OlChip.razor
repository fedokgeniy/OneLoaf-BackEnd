@* Filter chip (.ol-chip): a toggle button; the selected state is aria-pressed, not colour alone. *@
<button type="button" class="ol-chip" aria-pressed="@(Pressed ? "true" : "false")" disabled="@Disabled" @onclick="Toggle">
    @if (Pressed)
    {
        <OlIcon Name="IconName.Check" Size="IconSize.Sm" />
    }
    @ChildContent
</button>

@code {
    /// <summary>Selected.</summary>
    [Parameter] public bool Pressed { get; set; }

    /// <summary>Raised with the new state.</summary>
    [Parameter] public EventCallback<bool> PressedChanged { get; set; }

    /// <summary>Disabled.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Label.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Task Toggle() => PressedChanged.InvokeAsync(!Pressed);
}
