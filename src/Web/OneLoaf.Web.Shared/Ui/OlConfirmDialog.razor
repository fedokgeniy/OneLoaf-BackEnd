@* Confirmation of a destructive action on top of OlDialog: what happens, a way back and the action itself. *@
<OlDialog Open="Open" Title="@Title" OnClose="OnClose">
    <ChildContent>@ChildContent</ChildContent>
    <Footer>
        <OlButton Variant="ButtonVariant.Secondary" OnClick="OnClose">@CancelText</OlButton>
        <OlButton Variant="ButtonVariant.Danger" Loading="@Busy" OnClick="OnConfirm">@ConfirmText</OlButton>
    </Footer>
</OlDialog>

@code {
    /// <summary>Open state.</summary>
    [Parameter] public bool Open { get; set; }

    /// <summary>The question.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>What is removed and what stays.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Text of the confirming button.</summary>
    [Parameter] public string ConfirmText { get; set; } = "Delete";

    /// <summary>Text of the button that closes the dialog without the action.</summary>
    [Parameter] public string CancelText { get; set; } = "Keep it";

    /// <summary>True while the action runs.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>Raised when the action is confirmed.</summary>
    [Parameter] public EventCallback OnConfirm { get; set; }

    /// <summary>Raised when the dialog closes without the action.</summary>
    [Parameter] public EventCallback OnClose { get; set; }
}
