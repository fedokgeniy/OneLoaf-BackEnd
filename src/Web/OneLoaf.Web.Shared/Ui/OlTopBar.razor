@* Top app bar (.ol-topbar): optional leading slot (brand or back button), the page title, actions on the right. *@
<header class="ol-topbar @Class">
    @Leading
    <h1 class="ol-topbar__title @TitleClass" tabindex="-1">@Title</h1>
    @Actions
</header>

@code {
    /// <summary>Page title.</summary>
    [Parameter] public RenderFragment? Title { get; set; }

    /// <summary>Content before the title (brand, back button).</summary>
    [Parameter] public RenderFragment? Leading { get; set; }

    /// <summary>Buttons on the right.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>Extra class on the header.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Extra class on the title (e.g. to hide it visually on phones).</summary>
    [Parameter] public string? TitleClass { get; set; }
}
