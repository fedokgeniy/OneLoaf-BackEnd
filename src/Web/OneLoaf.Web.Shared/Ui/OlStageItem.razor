@* Batch stage (.ol-stage, StageItem page): number, name, status word with dot (never colour alone), planned and actual
   times, and the actions: the main one on the left (Start for a pending stage, Complete for a running one), Adjust on
   the right, and under them a slider that chooses by how many minutes Adjust changes the time of the stage. Done or
   skipped: no actions. Callbacks carry the stage; the page talks to the API. *@
@using OneLoaf.Web.Shared.Contracts.Core
@using OneLoaf.Web.Shared.Formatting

<article class="ol-stage @StateClass" aria-labelledby="@($"stage-{Stage.Id}")">
    <span class="ol-stage__marker" aria-hidden="true">
        @if (Stage.Status == StageStatuses.Done)
        {
            <OlIcon Name="IconName.Check" Size="IconSize.Sm" />
        }
        else
        {
            @Number
        }
    </span>
    <div class="ol-stage__head">
        <h3 class="ol-stage__name" id="@($"stage-{Stage.Id}")">@Stage.Name</h3>
        <span class="ol-badge @BadgeClass">@StatusText</span>
    </div>
    <dl class="ol-stage__times">
        <dt>Planned</dt>
        <dd>@DisplayFormat.Time(Stage.PlannedStartAt)–@DisplayFormat.Time(Stage.PlannedEndMaxAt) · @DisplayFormat.DurationRange(Stage.PlannedMinMinutes, Stage.PlannedMaxMinutes)@(Stage.IsOverridden ? " · adjusted" : null)</dd>
        @if (Stage.ActualStartAt is { } started)
        {
            <dt>Actual</dt>
            <dd>
                @(Stage.ActualEndAt is { } ended ? $"{DisplayFormat.Time(started)}–{DisplayFormat.Time(ended)}" : $"since {DisplayFormat.Time(started)}")
                @if (Stage.ExtendedMinutes > 0)
                {
                    <span class="ol-stage__deviation"> · +@DisplayFormat.Duration(Stage.ExtendedMinutes)</span>
                }
            </dd>
        }
    </dl>
    @if (Stage.Status is StageStatuses.Pending or StageStatuses.Running && Actionable)
    {
        <div class="ol-stage__actions stage-actions">
            @if (Stage.Status == StageStatuses.Pending)
            {
                <OlButton Large="true" Loading="Busy" OnClick="() => OnStart.InvokeAsync(Stage)">Start @Stage.Name.ToLowerInvariant()</OlButton>
            }
            else
            {
                <OlButton Large="true" Loading="Busy" OnClick="() => OnComplete.InvokeAsync(Stage)">Complete</OlButton>
            }
            <OlButton Variant="ButtonVariant.Secondary" Large="true" Icon="IconName.TimerPlus" Disabled="@(Busy || _minutes == 0)"
                      aria-label="@($"Adjust {Stage.Name.ToLowerInvariant()}: {DeltaText}")" OnClick="Adjust">Adjust</OlButton>
        </div>
        <div class="stage-adjust">
            <label class="stage-adjust__label" for="@SliderId">Change the time by <output class="stage-adjust__value" for="@SliderId">@DeltaText</output></label>
            <input id="@SliderId" class="stage-adjust__slider" type="range" min="@MinMinutes" max="@MaxMinutes" step="@StepMinutes"
                   value="@_minutes" disabled="@Busy" aria-valuetext="@DeltaText" @oninput="OnSlide" />
            <div class="stage-adjust__scale" aria-hidden="true">
                @if (MinMinutes < 0)
                {
                    <span>−1 h</span>
                }
                <span>0</span><span>+1 h</span><span>+2 h</span><span>+3 h</span>
            </div>
            <p class="ol-field__help">The following stages, the reminders and the ready time move with it.</p>
            <div class="stage-adjust__more">
                @if (Stage.Status == StageStatuses.Pending)
                {
                    <OlButton Variant="ButtonVariant.Ghost" Disabled="Busy" OnClick="() => OnSkip.InvokeAsync(Stage)">Skip</OlButton>
                }
                @if (Stage.IsOverridden)
                {
                    <OlButton Variant="ButtonVariant.Ghost" Disabled="Busy" OnClick="() => OnReset.InvokeAsync(Stage)">Reset to recipe</OlButton>
                }
            </div>
        </div>
    }
</article>

@code {
    /// <summary>The stage.</summary>
    [Parameter, EditorRequired] public BatchStageDto Stage { get; set; } = default!;

    /// <summary>Position shown in the marker.</summary>
    [Parameter] public int Number { get; set; }

    /// <summary>A request for this stage runs.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>Actions are offered (false for a finished or cancelled batch).</summary>
    [Parameter] public bool Actionable { get; set; } = true;

    /// <summary>Start pressed.</summary>
    [Parameter] public EventCallback<BatchStageDto> OnStart { get; set; }

    /// <summary>Complete pressed.</summary>
    [Parameter] public EventCallback<BatchStageDto> OnComplete { get; set; }

    /// <summary>Skip pressed.</summary>
    [Parameter] public EventCallback<BatchStageDto> OnSkip { get; set; }

    /// <summary>Adjust pressed: the stage and the minutes chosen with the slider.</summary>
    [Parameter] public EventCallback<StageAdjustment> OnAdjust { get; set; }

    /// <summary>"Reset to recipe" pressed (offered when the durations were changed for this batch).</summary>
    [Parameter] public EventCallback<BatchStageDto> OnReset { get; set; }

    /// <summary>
    /// A stage that has not started can be planned shorter or longer. A running stage only gets more time: to end it
    /// earlier the baker completes it.
    /// </summary>
    private int MinMinutes => Stage.Status == StageStatuses.Running ? 0 : -60;

    private const int MaxMinutes = 180;
    private const int StepMinutes = 5;

    /// <summary>A running stage usually needs more time: the slider starts at the half hour bakers add most often.</summary>
    private const int RunningDefault = 30;

    private readonly string _id = ElementIds.Next("stage-adjust");
    private Guid _stageId;
    private string? _status;
    private int _minutes;

    private string SliderId => _id;

    private string DeltaText => _minutes switch
    {
        0 => "no change",
        > 0 => $"+{DisplayFormat.Duration(_minutes)}",
        _ => $"−{DisplayFormat.Duration(-_minutes)}",
    };

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        // Another stage, or the same stage in another state: the slider starts from its default again.
        if (Stage.Id != _stageId || Stage.Status != _status)
        {
            _stageId = Stage.Id;
            _status = Stage.Status;
            _minutes = Stage.Status == StageStatuses.Running ? RunningDefault : 0;
        }
    }

    private void OnSlide(ChangeEventArgs e) =>
        _minutes = int.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var minutes)
            ? Math.Clamp(minutes, MinMinutes, MaxMinutes)
            : _minutes;

    private Task Adjust() => _minutes == 0 ? Task.CompletedTask : OnAdjust.InvokeAsync(new StageAdjustment(Stage, _minutes));

    private string? StateClass => Stage.Status switch
    {
        StageStatuses.Running => "is-running",
        StageStatuses.Done => "is-done",
        StageStatuses.Skipped => "is-skipped",
        _ => null,
    };

    private string BadgeClass => Stage.Status switch
    {
        StageStatuses.Running => "ol-badge--running",
        StageStatuses.Done => "ol-badge--done",
        StageStatuses.Skipped => "ol-badge--neutral",
        _ => "ol-badge--planned",
    };

    private string StatusText => Stage.Status switch
    {
        StageStatuses.Running => "Running",
        StageStatuses.Done => "Done",
        StageStatuses.Skipped => "Skipped",
        _ => "Planned",
    };
}
