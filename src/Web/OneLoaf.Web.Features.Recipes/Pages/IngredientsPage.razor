@page "/ingredients"
@inherits FluxorComponent
@using OneLoaf.Web.Features.Recipes.Components
@using OneLoaf.Web.Features.Recipes.Models
@using OneLoaf.Web.Features.Recipes.State
@using OneLoaf.Web.Shared.Api
@using OneLoaf.Web.Shared.Contracts
@using OneLoaf.Web.Shared.Contracts.Core
@using OneLoaf.Web.Shared.Formatting
@using OneLoaf.Web.Shared.Forms
@using OneLoaf.Web.Shared.State

<ShellTitle Text="Ingredients & stock">
    <Actions>
        <OlButton Variant="ButtonVariant.Secondary" Icon="IconName.Plus" class="app-hide-compact" OnClick="() => OpenIngredientForm(null)">New ingredient</OlButton>
    </Actions>
</ShellTitle>

<div class="ol-container ingredients">
    <div class="ol-split ingredients__split @(State.Value.SelectedId is null ? null : "ingredients__split--detail")">
        <section class="ingredients__list" aria-label="Ingredient list">
            <div class="ingredients__filters">
                <div class="ol-field ingredients__search">
                    <label class="ol-visually-hidden" for="ingredient-search">Search ingredients</label>
                    <div class="ol-field__control">
                        <span class="ingredients__search-icon"><OlIcon Name="IconName.Search" /></span>
                        <input id="ingredient-search" class="ol-input ingredients__search-input" type="search" placeholder="Search ingredients"
                               value="@_search" @oninput="OnSearch" />
                    </div>
                </div>
                <OlButton Variant="ButtonVariant.Secondary" Icon="IconName.Plus" class="ingredients__new" OnClick="() => OpenIngredientForm(null)">New ingredient</OlButton>
            </div>
            @if (State.Value.Reference.Value is { } reference)
            {
                <div class="ingredients__chips" role="group" aria-label="Category">
                    <OlChip Pressed="State.Value.Category is null" PressedChanged="_ => SetCategory(null)">All</OlChip>
                    @foreach (var category in reference.Categories)
                    {
                        <OlChip @key="category.Code" Pressed="State.Value.Category == category.Code" PressedChanged="_ => SetCategory(category.Code)">@category.Name</OlChip>
                    }
                </div>
            }
            <div aria-busy="@(State.Value.List is Loadable<PagedResult<IngredientDto>>.Loading ? "true" : "false")">
                @switch (State.Value.List)
                {
                    case Loadable<PagedResult<IngredientDto>>.Failed { Error: var error }:
                        <OlAlert Kind="AlertKind.Danger" Title="The ingredients could not be loaded." CorrelationId="@error.CorrelationId">
                            <p>@error.Message</p>
                            <OlButton Variant="ButtonVariant.Secondary" OnClick="Reload">Try again</OlButton>
                        </OlAlert>
                        break;
                    case { Value: { } result }:
                        @if (result.Items.Count == 0)
                        {
                            <OlEmptyState Title="@(IsFiltered ? "No ingredients match" : "No ingredients yet")" Icon="IconName.Calculator"
                                          Text="@(IsFiltered ? "Try another search or category." : "Add flour, water, salt and your starter, then their prices.")">
                                <Action><OlButton OnClick="() => OpenIngredientForm(null)" Icon="IconName.Plus">New ingredient</OlButton></Action>
                            </OlEmptyState>
                        }
                        else
                        {
                            <ul class="ol-table-wrap ingredients__rows">
                                @foreach (var item in result.Items)
                                {
                                    <li @key="item.Id">
                                        <button type="button" class="ingredients__row" aria-current="@(item.Id == State.Value.SelectedId ? "true" : null)"
                                                @onclick="() => Dispatcher.Dispatch(new SelectIngredient(item.Id))">
                                            <span class="ingredients__name">@item.Name</span>
                                            @if (item.CurrentPrice is { } price)
                                            {
                                                <span class="ol-num ingredients__price">@DisplayFormat.UnitPrice(price.UnitPrice, item.UnitCode)</span>
                                            }
                                            else
                                            {
                                                @* A starter gets its price from the flour and water of its feedings. *@
                                                <span class="ol-badge ol-badge--running ingredients__price">@(item.StarterId is null ? "Price missing" : "Priced at feeding")</span>
                                            }
                                            <span class="ingredients__category">@CategoryName(item.CategoryCode)@(item.ProteinPercent is { } protein ? $" · {DisplayFormat.Percent(protein)} protein" : null)</span>
                                            @if (item.Stock is { } stock)
                                            {
                                                <span class="ingredients__stock">
                                                    @if (item.IsLowStock)
                                                    {
                                                        <span class="ol-badge ol-badge--overdue"><OlIcon Name="IconName.Alert" /> Low stock</span>
                                                    }
                                                    <span class="ol-num">@DisplayFormat.Quantity(stock, item.UnitCode) in stock</span>
                                                </span>
                                            }
                                        </button>
                                    </li>
                                }
                            </ul>
                            @if (result.TotalCount > result.Items.Count)
                            {
                                <p class="ingredients__more">Showing @result.Items.Count of @result.TotalCount. Search to narrow the list.</p>
                            }
                        }
                        break;
                    default:
                        <OlSkeleton Variant="SkeletonVariant.Row" Count="6" />
                        break;
                }
            </div>
        </section>

        <section class="ingredients__detail" aria-label="Ingredient details">
            @if (Selected is { } ingredient)
            {
                <button type="button" class="ol-btn ol-btn--ghost ingredients__back" @onclick="() => Dispatcher.Dispatch(new SelectIngredient(null))">
                    <OlIcon Name="IconName.ChevronLeft" /> All ingredients
                </button>
                <IngredientCard Ingredient="ingredient" CategoryName="@CategoryName(ingredient.CategoryCode)" Flour="FlourOf(ingredient)"
                                Prices="State.Value.Prices" Movements="State.Value.Movements"
                                PhotoSrc="@State.Value.PhotoSrc" PhotoLoading="State.Value.PhotoLoading" PhotoBusy="State.Value.PhotoBusy"
                                OnEdit="() => OpenIngredientForm(ingredient)" OnDelete="() => _confirmDelete = ingredient"
                                OnEditFlour="OpenFlourForm" OnDeleteFlour="flour => _confirmDeleteFlour = flour"
                                OnAddRecord="() => OpenRecord(ingredient)" OnAdjust="() => OpenAdjust(ingredient)"
                                OnEditPrice="OpenPriceEdit" OnDeletePrice="price => _confirmDeletePrice = price"
                                OnPhotoSelected="photo => Dispatcher.Dispatch(new UploadIngredientPhoto(ingredient.Id, photo))"
                                OnPhotoRemove="() => Dispatcher.Dispatch(new RemoveIngredientPhoto(ingredient.Id))" />
            }
            else
            {
                <div class="ingredients__placeholder">
                    <OlEmptyState Title="Choose an ingredient" Icon="IconName.Calculator" Text="Its prices, stock and flour details appear here." />
                </div>
            }
        </section>
    </div>
</div>

<IngredientFormDialog Form="_ingredientForm" Title="@(_editing is null ? "New ingredient" : $"Edit {_editing.Name}")"
                      Categories="CategoryOptions" Units="UnitOptions" Flours="FlourOptions" IsFlourCategory="IsFlourCategory"
                      Busy="State.Value.Busy" Error="_ingredientError"
                      OnSubmit="SaveIngredient" OnClose="CloseIngredientForm" OnAddFlour="() => OpenFlourForm(null)" />

<FlourFormDialog Open="_flourOpen" Flour="_editingFlour" FlourTypes="FlourTypeOptions" Busy="State.Value.Busy" Error="_flourError"
                 OnSave="SaveFlour" OnClose="CloseFlourForm" />

<IngredientRecordDialog Ingredient="_recordFor" Form="_recordForm" Currencies="CurrencyOptions" Busy="State.Value.Busy" Error="_recordError"
                        OnSubmit="SaveRecord" OnClose="() => _recordFor = null" />

<StockAdjustDialog Ingredient="_adjustFor" Form="_adjustForm" Busy="State.Value.Busy" Error="_adjustError"
                   OnSubmit="SaveAdjustment" OnClose="() => _adjustFor = null" />

<PriceEditDialog Open="_editingPrice is not null && Selected is not null" UnitCode="@Selected?.UnitCode" Form="_priceEditForm"
                 Currencies="CurrencyOptions" Busy="State.Value.Busy" Error="_priceEditError"
                 OnSubmit="SavePriceEdit" OnClose="() => _editingPrice = null" />

<OlConfirmDialog Open="_confirmDeletePrice is not null" Title="Delete this price?" ConfirmText="Delete price" Busy="State.Value.Busy"
                 OnConfirm="DeletePrice" OnClose="() => _confirmDeletePrice = null">
    <p>
        The price from @(_confirmDeletePrice is { } doomed ? DisplayFormat.Date(doomed.EffectiveFrom) : null) is removed.
        Recipe costs for its dates use the previous price, or stay incomplete when there is none.
    </p>
</OlConfirmDialog>

<OlConfirmDialog Open="_confirmDeleteFlour is not null" Title="Delete these flour details?" Busy="State.Value.Busy"
                 OnConfirm="DeleteFlour" OnClose="() => _confirmDeleteFlour = null">
    <p>“@_confirmDeleteFlour?.Name” is removed from the flour catalog. Ingredients and starters that use it stay, without the flour details.</p>
</OlConfirmDialog>

<OlConfirmDialog Open="_confirmDelete is not null" Title="Delete this ingredient?" Busy="State.Value.Busy"
                 OnConfirm="Delete" OnClose="() => _confirmDelete = null">
    <p>“@_confirmDelete?.Name”, its price history and its stock movements are removed. An ingredient used in a recipe cannot be deleted.</p>
</OlConfirmDialog>
