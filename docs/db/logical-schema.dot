digraph oneloaf {
  graph [rankdir=LR, splines=true, nodesep=0.4, ranksep=0.9, newrank=true, fontname="Helvetica", fontsize=20, label=<<b>OneLoaf - logical database schema</b><br/><font point-size="12">PK - primary key, FK - foreign key; "-&gt; table" - reference to a reference table or to the owner (users); lines - relationships of the domain</font>>, labelloc=t, pad=0.4];
  node [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, color="#374151", penwidth=1.2, dir=both];
  subgraph cluster_ref { label=<<b>Reference data</b>>; fontsize=15; fontcolor="#6b7280"; style="rounded,filled"; color="#6b7280"; fillcolor="#f3f4f6"; penwidth=2;
    units [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" style="rounded" color="#6b7280"><tr><td colspan="3" bgcolor="#6b7280"><font color="white"><b>units</b></font></td></tr><tr><td align="left" port="code"><b>code</b></td><td align="left"><font color="#6b7280">varchar</font></td><td align="left"><font color="#6b7280">PK</font></td></tr><tr><td align="left" port="name">name</td><td align="left"><font color="#6b7280">varchar</font></td><td> </td></tr><tr><td align="left" port="dimension">dimension</td><td align="left"><font color="#6b7280">varchar</font></td><td> </td></tr><tr><td align="left" port="factor_to_base">factor_to_base</td><td align="left"><font color="#6b7280">numeric</font></td><td> </td></tr><tr><td align="left" port="sort_order">sort_order</td><td align="left"><font color="#6b7280">int</font></td><td> </td></tr></table>>];
    currencies [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" style="rounded" color="#6b7280"><tr><td colspan="3" bgcolor="#6b7280"><font color="white"><b>currencies</b></font></td></tr><tr><td align="left" port="code"><b>code</b></td><td align="left"><font color="#6b7280">char</font></td><td align="left"><font color="#6b7280">PK</font></td></tr><tr><td align="left" port="name">name</td><td align="left"><font color="#6b7280">varchar</font></td><td> </td></tr><tr><td align="left" port="minor_units">minor_units</td><td align="left"><font color="#6b7280">smallint</font></td><td> </td></tr></table>>];
    stage_types [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" style="rounded" color="#6b7280"><tr><td colspan="3" bgcolor="#6b7280"><font color="white"><b>stage_types</b></font></td></tr><tr><td align="left" port="code"><b>code</b></td><td align="left"><font color="#6b7280">varchar</font></td><td align="left"><font color="#6b7280">PK</font></td></tr><tr><td align="left" port="name">name</td><td align="left"><font color="#6b7280">varchar</font></td><td> </td></tr><tr><td align="left" port="is_fermentation">is_fermentation</td><td align="left"><font color="#6b7280">bool</font></td><td> </td></tr><tr><td align="left" port="default_uses_oven">default_uses_oven</td><td align="left"><font color="#6b7280">bool</font></td><td> </td></tr><tr><td align="left" port="default_uses_mixer">default_uses_mixer</td><td align="left"><font color="#6b7280">bool</font></td><td> </td></tr><tr><td align="left" port="sort_order">sort_order</td><td align="left"><font color="#6b7280">int</font></td><td> </td></tr></table>>];
    ingredient_categories [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" style="rounded" color="#6b7280"><tr><td colspan="3" bgcolor="#6b7280"><font color="white"><b>ingredient_categories</b></font></td></tr><tr><td align="left" port="code"><b>code</b></td><td align="left"><font color="#6b7280">varchar</font></td><td align="left"><font color="#6b7280">PK</font></td></tr><tr><td align="left" port="name">name</td><td align="left"><font color="#6b7280">varchar</font></td><td> </td></tr><tr><td align="left" port="is_flour">is_flour</td><td align="left"><font color="#6b7280">bool</font></td><td> </td></tr><tr><td align="left" port="is_liquid">is_liquid</td><td align="left"><font color="#6b7280">bool</font></td><td> </td></tr><tr><td align="left" port="sort_order">sort_order</td><td align="left"><font color="#6b7280">int</font></td><td> </td></tr></table>>];
    flour_types [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" style="rounded" color="#6b7280"><tr><td colspan="3" bgcolor="#6b7280"><font color="white"><b>flour_types</b></font></td></tr><tr><td align="left" port="code"><b>code</b></td><td align="left"><font color="#6b7280">varchar</font></td><td align="left"><font color="#6b7280">PK</font></td></tr><tr><td align="left" port="name">name</td><td align="left"><font color="#6b7280">varchar</font></td><td> </td></tr><tr><td align="left" port="sort_order">sort_order</td><td align="left"><font color="#6b7280">int</font></td><td> </td></tr></table>>];
  }
  subgraph cluster_acc { label=<<b>E1 Accounts and kitchen</b>>; fontsize=15; fontcolor="#2563eb"; style="rounded,filled"; color="#2563eb"; fillcolor="#eff6ff"; penwidth=2;
    users [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" style="rounded" color="#2563eb"><tr><td colspan="3" bgcolor="#2563eb"><font color="white"><b>users</b></font></td></tr><tr><td align="left" port="id"><b>id</b></td><td align="left"><font color="#6b7280">uuid</font></td><td align="left"><font color="#2563eb">PK</font></td></tr><tr><td align="left" port="email">email</td><td align="left"><font color="#6b7280">varchar</font></td><td> </td></tr><tr><td align="left" port="normalized_email">normalized_email</td><td align="left"><font color="#6b7280">varchar</font></td><td> </td></tr><tr><td align="left" port="password_hash">password_hash</td><td align="left"><font color="#6b7280">varchar</font></td><td> </td></tr><tr><td align="left" port="display_name">display_name</td><td align="left"><font color="#6b7280">varchar</font></td><td> </td></tr><tr><td align="left" port="role">role</td><td align="left"><font color="#6b7280">varchar</font></td><td> </td></tr><tr><td align="left" port="last_login_at">last_login_at</td><td align="left"><font color="#6b7280">timestamptz</font></td><td> </td></tr><tr><td align="left" colspan="3"><font color="#9ca3af">+ created_at, updated_at</font></td></tr></table>>];
    kitchen_settings [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" style="rounded" color="#2563eb"><tr><td colspan="3" bgcolor="#2563eb"><font color="white"><b>kitchen_settings</b></font></td></tr><tr><td align="left" port="user_id"><b>user_id</b></td><td align="left"><font color="#6b7280">-&gt; users</font></td><td align="left"><font color="#2563eb">PK</font></td></tr><tr><td align="left" port="oven_power_kw">oven_power_kw</td><td align="left"><font color="#6b7280">numeric</font></td><td> </td></tr><tr><td align="left" port="oven_capacity_loaves">oven_capacity_loaves</td><td align="left"><font color="#6b7280">int</font></td><td> </td></tr><tr><td align="left" port="mixer_bowl_capacity_kg">mixer_bowl_capacity_kg</td><td align="left"><font color="#6b7280">numeric</font></td><td> </td></tr><tr><td align="left" port="electricity_tariff_per_kwh">electricity_tariff_per_kwh</td><td align="left"><font color="#6b7280">numeric</font></td><td> </td></tr><tr><td align="left" port="packaging_cost_per_loaf">packaging_cost_per_loaf</td><td align="left"><font color="#6b7280">numeric</font></td><td> </td></tr><tr><td align="left" port="loss_rate_percent">loss_rate_percent</td><td align="left"><font color="#6b7280">numeric</font></td><td> </td></tr><tr><td align="left" port="labor_rate_per_hour">labor_rate_per_hour</td><td align="left"><font color="#6b7280">numeric</font></td><td> </td></tr><tr><td align="left" port="currency"><i>currency</i></td><td align="left"><font color="#6b7280">-&gt; currencies</font></td><td align="left"><font color="#2563eb">FK</font></td></tr><tr><td align="left" port="time_zone">time_zone</td><td align="left"><font color="#6b7280">varchar</font></td><td> </td></tr><tr><td align="left" colspan="3"><font color="#9ca3af">+ updated_at</font></td></tr></table>>];
    push_subscriptions [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" style="rounded" color="#2563eb"><tr><td colspan="3" bgcolor="#2563eb"><font color="white"><b>push_subscriptions</b></font></td></tr><tr><td align="left" port="id"><b>id</b></td><td align="left"><font color="#6b7280">uuid</font></td><td align="left"><font color="#2563eb">PK</font></td></tr><tr><td align="left" port="user_id"><i>user_id</i></td><td align="left"><font color="#6b7280">-&gt; users</font></td><td align="left"><font color="#2563eb">FK</font></td></tr><tr><td align="left" port="endpoint">endpoint</td><td align="left"><font color="#6b7280">varchar</font></td><td> </td></tr><tr><td align="left" port="p256dh">p256dh</td><td align="left"><font color="#6b7280">varchar</font></td><td> </td></tr><tr><td align="left" port="auth">auth</td><td align="left"><font color="#6b7280">varchar</font></td><td> </td></tr><tr><td align="left" colspan="3"><font color="#9ca3af">+ created_at</font></td></tr></table>>];
  }
  subgraph cluster_cat { label=<<b>E3 Catalog and prices</b>>; fontsize=15; fontcolor="#059669"; style="rounded,filled"; color="#059669"; fillcolor="#ecfdf5"; penwidth=2;
    flours [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" style="rounded" color="#059669"><tr><td colspan="3" bgcolor="#059669"><font color="white"><b>flours</b></font></td></tr><tr><td align="left" port="id"><b>id</b></td><td align="left"><font color="#6b7280">uuid</font></td><td align="left"><font color="#059669">PK</font></td></tr><tr><td align="left" port="owner_id"><i>owner_id</i></td><td align="left"><font color="#6b7280">-&gt; users</font></td><td align="left"><font color="#059669">FK</font></td></tr><tr><td align="left" port="name">name</td><td align="left"><font color="#6b7280">varchar</font></td><td> </td></tr><tr><td align="left" port="flour_type_code"><i>flour_type_code</i></td><td align="left"><font color="#6b7280">-&gt; flour_types</font></td><td align="left"><font color="#059669">FK</font></td></tr><tr><td align="left" port="protein_percent">protein_percent</td><td align="left"><font color="#6b7280">numeric</font></td><td> </td></tr><tr><td align="left" port="grind">grind</td><td align="left"><font color="#6b7280">varchar</font></td><td> </td></tr><tr><td align="left" port="notes">notes</td><td align="left"><font color="#6b7280">varchar</font></td><td> </td></tr><tr><td align="left" colspan="3"><font color="#9ca3af">+ created_at, updated_at</font></td></tr></table>>];
    ingredients [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" style="rounded" color="#059669"><tr><td colspan="3" bgcolor="#059669"><font color="white"><b>ingredients</b></font></td></tr><tr><td align="left" port="id"><b>id</b></td><td align="left"><font color="#6b7280">uuid</font></td><td align="left"><font color="#059669">PK</font></td></tr><tr><td align="left" port="owner_id"><i>owner_id</i></td><td align="left"><font color="#6b7280">-&gt; users</font></td><td align="left"><font color="#059669">FK</font></td></tr><tr><td align="left" port="name">name</td><td align="left"><font color="#6b7280">varchar</font></td><td> </td></tr><tr><td align="left" port="category_code"><i>category_code</i></td><td align="left"><font color="#6b7280">-&gt; ingredient_categories</font></td><td align="left"><font color="#059669">FK</font></td></tr><tr><td align="left" port="unit_code"><i>unit_code</i></td><td align="left"><font color="#6b7280">-&gt; units</font></td><td align="left"><font color="#059669">FK</font></td></tr><tr><td align="left" port="flour_id"><i>flour_id</i></td><td align="left"><font color="#6b7280">uuid</font></td><td align="left"><font color="#059669">FK</font></td></tr><tr><td align="left" colspan="3"><font color="#9ca3af">+ created_at, updated_at</font></td></tr></table>>];
    ingredient_prices [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" style="rounded" color="#059669"><tr><td colspan="3" bgcolor="#059669"><font color="white"><b>ingredient_prices</b></font></td></tr><tr><td align="left" port="id"><b>id</b></td><td align="left"><font color="#6b7280">uuid</font></td><td align="left"><font color="#059669">PK</font></td></tr><tr><td align="left" port="ingredient_id"><i>ingredient_id</i></td><td align="left"><font color="#6b7280">uuid</font></td><td align="left"><font color="#059669">FK</font></td></tr><tr><td align="left" port="price">price</td><td align="left"><font color="#6b7280">numeric</font></td><td> </td></tr><tr><td align="left" port="per_quantity">per_quantity</td><td align="left"><font color="#6b7280">numeric</font></td><td> </td></tr><tr><td align="left" port="currency"><i>currency</i></td><td align="left"><font color="#6b7280">-&gt; currencies</font></td><td align="left"><font color="#059669">FK</font></td></tr><tr><td align="left" port="effective_from">effective_from</td><td align="left"><font color="#6b7280">date</font></td><td> </td></tr><tr><td align="left" colspan="3"><font color="#9ca3af">+ created_at</font></td></tr></table>>];
  }
  subgraph cluster_rec { label=<<b>E2 Recipes and variants</b>>; fontsize=15; fontcolor="#d97706"; style="rounded,filled"; color="#d97706"; fillcolor="#fffbeb"; penwidth=2;
    recipes [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" style="rounded" color="#d97706"><tr><td colspan="3" bgcolor="#d97706"><font color="white"><b>recipes</b></font></td></tr><tr><td align="left" port="id"><b>id</b></td><td align="left"><font color="#6b7280">uuid</font></td><td align="left"><font color="#d97706">PK</font></td></tr><tr><td align="left" port="owner_id"><i>owner_id</i></td><td align="left"><font color="#6b7280">-&gt; users</font></td><td align="left"><font color="#d97706">FK</font></td></tr><tr><td align="left" port="parent_recipe_id"><i>parent_recipe_id</i></td><td align="left"><font color="#6b7280">uuid</font></td><td align="left"><font color="#d97706">FK</font></td></tr><tr><td align="left" port="copied_from_published_recipe_id"><i>copied_from_published_recipe_id</i></td><td align="left"><font color="#6b7280">uuid</font></td><td align="left"><font color="#d97706">FK</font></td></tr><tr><td align="left" port="title">title</td><td align="left"><font color="#6b7280">varchar</font></td><td> </td></tr><tr><td align="left" port="description">description</td><td align="left"><font color="#6b7280">varchar</font></td><td> </td></tr><tr><td align="left" port="yield_loaves">yield_loaves</td><td align="left"><font color="#6b7280">int</font></td><td> </td></tr><tr><td align="left" port="loaf_weight_g">loaf_weight_g</td><td align="left"><font color="#6b7280">numeric</font></td><td> </td></tr><tr><td align="left" port="variant_overrides">variant_overrides</td><td align="left"><font color="#6b7280">jsonb</font></td><td> </td></tr><tr><td align="left" port="notes">notes</td><td align="left"><font color="#6b7280">varchar</font></td><td> </td></tr><tr><td align="left" port="is_archived">is_archived</td><td align="left"><font color="#6b7280">bool</font></td><td> </td></tr><tr><td align="left" colspan="3"><font color="#9ca3af">+ created_at, updated_at</font></td></tr></table>>];
    recipe_ingredients [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" style="rounded" color="#d97706"><tr><td colspan="3" bgcolor="#d97706"><font color="white"><b>recipe_ingredients</b></font></td></tr><tr><td align="left" port="id"><b>id</b></td><td align="left"><font color="#6b7280">uuid</font></td><td align="left"><font color="#d97706">PK</font></td></tr><tr><td align="left" port="recipe_id"><i>recipe_id</i></td><td align="left"><font color="#6b7280">uuid</font></td><td align="left"><font color="#d97706">FK</font></td></tr><tr><td align="left" port="ingredient_id"><i>ingredient_id</i></td><td align="left"><font color="#6b7280">uuid</font></td><td align="left"><font color="#d97706">FK</font></td></tr><tr><td align="left" port="quantity">quantity</td><td align="left"><font color="#6b7280">numeric</font></td><td> </td></tr><tr><td align="left" port="is_optional">is_optional</td><td align="left"><font color="#6b7280">bool</font></td><td> </td></tr><tr><td align="left" port="sort_order">sort_order</td><td align="left"><font color="#6b7280">int</font></td><td> </td></tr><tr><td align="left" port="note">note</td><td align="left"><font color="#6b7280">varchar</font></td><td> </td></tr><tr><td align="left" port="replaces_item_id"><i>replaces_item_id</i></td><td align="left"><font color="#6b7280">uuid</font></td><td align="left"><font color="#d97706">FK</font></td></tr><tr><td align="left" port="is_removed">is_removed</td><td align="left"><font color="#6b7280">bool</font></td><td> </td></tr></table>>];
    recipe_stages [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" style="rounded" color="#d97706"><tr><td colspan="3" bgcolor="#d97706"><font color="white"><b>recipe_stages</b></font></td></tr><tr><td align="left" port="id"><b>id</b></td><td align="left"><font color="#6b7280">uuid</font></td><td align="left"><font color="#d97706">PK</font></td></tr><tr><td align="left" port="recipe_id"><i>recipe_id</i></td><td align="left"><font color="#6b7280">uuid</font></td><td align="left"><font color="#d97706">FK</font></td></tr><tr><td align="left" port="sort_order">sort_order</td><td align="left"><font color="#6b7280">int</font></td><td> </td></tr><tr><td align="left" port="name">name</td><td align="left"><font color="#6b7280">varchar</font></td><td> </td></tr><tr><td align="left" port="stage_type_code"><i>stage_type_code</i></td><td align="left"><font color="#6b7280">-&gt; stage_types</font></td><td align="left"><font color="#d97706">FK</font></td></tr><tr><td align="left" port="min_duration_minutes">min_duration_minutes</td><td align="left"><font color="#6b7280">int</font></td><td> </td></tr><tr><td align="left" port="max_duration_minutes">max_duration_minutes</td><td align="left"><font color="#6b7280">int</font></td><td> </td></tr><tr><td align="left" port="active_minutes">active_minutes</td><td align="left"><font color="#6b7280">int</font></td><td> </td></tr><tr><td align="left" port="proof_mode">proof_mode</td><td align="left"><font color="#6b7280">varchar</font></td><td> </td></tr><tr><td align="left" port="temperature_c">temperature_c</td><td align="left"><font color="#6b7280">numeric</font></td><td> </td></tr><tr><td align="left" port="uses_oven">uses_oven</td><td align="left"><font color="#6b7280">bool</font></td><td> </td></tr><tr><td align="left" port="uses_mixer">uses_mixer</td><td align="left"><font color="#6b7280">bool</font></td><td> </td></tr><tr><td align="left" port="is_optional">is_optional</td><td align="left"><font color="#6b7280">bool</font></td><td> </td></tr><tr><td align="left" port="instructions">instructions</td><td align="left"><font color="#6b7280">varchar</font></td><td> </td></tr><tr><td align="left" port="replaces_stage_id"><i>replaces_stage_id</i></td><td align="left"><font color="#6b7280">uuid</font></td><td align="left"><font color="#d97706">FK</font></td></tr><tr><td align="left" port="is_removed">is_removed</td><td align="left"><font color="#6b7280">bool</font></td><td> </td></tr></table>>];
  }
  subgraph cluster_prod { label=<<b>E5 Production</b>>; fontsize=15; fontcolor="#dc2626"; style="rounded,filled"; color="#dc2626"; fillcolor="#fef2f2"; penwidth=2;
