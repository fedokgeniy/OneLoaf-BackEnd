# assistant: one typical request per operation, generated from the recorded examples.
# Base URLs: https://<domain>/assistant (production), http://localhost:5081 (local)
# Use with the VS Code REST Client or JetBrains HTTP Client; set @token to an access token from POST /api/v1/auth/login.
@baseUrl = http://localhost:5081
@token = <access token>

### Analyse a finished bake
POST {{baseUrl}}/api/v1/bake-records/11656437-e094-4620-a1b1-ce7df5c8c422/analysis
Authorization: Bearer {{token}}

### Today's assistant usage
GET {{baseUrl}}/api/v1/usage/me
Authorization: Bearer {{token}}

### List conversations
GET {{baseUrl}}/api/v1/conversations
Authorization: Bearer {{token}}

### Start a conversation
POST {{baseUrl}}/api/v1/conversations
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": null
}

### Delete a conversation and its messages
DELETE {{baseUrl}}/api/v1/conversations/332a882e-dff3-45dc-bf74-75091dc3c59e
Authorization: Bearer {{token}}

### Messages of a conversation
GET {{baseUrl}}/api/v1/conversations/85bd4bc6-cea7-4a44-b609-b2de57cf13e5/messages
Authorization: Bearer {{token}}

### Send a message to the assistant
POST {{baseUrl}}/api/v1/conversations/85bd4bc6-cea7-4a44-b609-b2de57cf13e5/messages
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "content": "Plan 2 loaves of my Country sourdough for next Saturday morning."
}

### Confirm a batch proposal
POST {{baseUrl}}/api/v1/conversations/85bd4bc6-cea7-4a44-b609-b2de57cf13e5/actions/e7e0f86f-a053-4b30-b894-11074d4696b0/confirm
Authorization: Bearer {{token}}

### Decline a batch proposal
POST {{baseUrl}}/api/v1/conversations/85bd4bc6-cea7-4a44-b609-b2de57cf13e5/actions/4216299e-bc0e-4156-9d43-e85eb2105aae/decline
Authorization: Bearer {{token}}

