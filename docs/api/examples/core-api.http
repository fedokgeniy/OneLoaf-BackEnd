  "rating": 4,
  "comment": "Good oven spring, crumb a bit tight."
}

### Planned vs actual stage times
GET {{baseUrl}}/api/v1/bake-records/11656437-e094-4620-a1b1-ce7df5c8c422/stage-log
Authorization: Bearer {{token}}

### Upload a crumb photo
POST {{baseUrl}}/api/v1/bake-records/11656437-e094-4620-a1b1-ce7df5c8c422/photos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "multipart/form-data": {
    "file": "<crumb.png, image/png, 29 bytes>"
  }
}

### Crumb photos of a bake record
GET {{baseUrl}}/api/v1/bake-records/11656437-e094-4620-a1b1-ce7df5c8c422/photos
Authorization: Bearer {{token}}

### The image of a crumb photo
GET {{baseUrl}}/api/v1/bake-records/11656437-e094-4620-a1b1-ce7df5c8c422/photos/e9049bd0-4c97-4f27-b145-7214e2d41617
Authorization: Bearer {{token}}

### Delete a crumb photo
DELETE {{baseUrl}}/api/v1/bake-records/11656437-e094-4620-a1b1-ce7df5c8c422/photos/36fd89be-39c5-4afd-8f6a-3f8311dc9d10
Authorization: Bearer {{token}}

### Store the assistant's analysis
PUT {{baseUrl}}/api/v1/bake-records/11656437-e094-4620-a1b1-ce7df5c8c422/analysis
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "analysis": "Bulk fermentation ended early; give the dough more time next bake."
}

### Browse and search the library
GET {{baseUrl}}/api/v1/library?search=sourdough&page=1&pageSize=20

### A published recipe
GET {{baseUrl}}/api/v1/library/4183c7fb-b3fc-4f46-b2dc-2ee80e31490a

### The photo of a published recipe
GET {{baseUrl}}/api/v1/library/4183c7fb-b3fc-4f46-b2dc-2ee80e31490a/photo

### Comments of a published recipe
GET {{baseUrl}}/api/v1/library/4183c7fb-b3fc-4f46-b2dc-2ee80e31490a/comments?page=1&pageSize=20
Authorization: Bearer {{token}}

### Comment a published recipe
POST {{baseUrl}}/api/v1/library/4183c7fb-b3fc-4f46-b2dc-2ee80e31490a/comments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "body": "Baked it on Sunday, lovely crumb!"
}

### Withdraw an own publication
POST {{baseUrl}}/api/v1/library/4183c7fb-b3fc-4f46-b2dc-2ee80e31490a/unpublish
Authorization: Bearer {{token}}

### Remove an own comment
DELETE {{baseUrl}}/api/v1/library/4183c7fb-b3fc-4f46-b2dc-2ee80e31490a/comments/a1b359da-11b3-4301-b794-dd039f880c5a
Authorization: Bearer {{token}}

### Set the own reaction
PUT {{baseUrl}}/api/v1/library/4183c7fb-b3fc-4f46-b2dc-2ee80e31490a/reactions/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reaction": "want_to_bake"
}

### Remove the own reaction
DELETE {{baseUrl}}/api/v1/library/4183c7fb-b3fc-4f46-b2dc-2ee80e31490a/reactions/me
Authorization: Bearer {{token}}

### Copy a published recipe into the own workspace
POST {{baseUrl}}/api/v1/library/4183c7fb-b3fc-4f46-b2dc-2ee80e31490a/copy
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ingredients": [
    {
      "name": "Bread flour",
      "useIngredientId": "765af749-e2a8-4f3f-99fe-02ff34bf2676",
      "stockQuantity": null
    },
    {
      "name": "Salt",
      "useIngredientId": null,
      "stockQuantity": 500
    }
  ]
}

### Report a publication or a comment
POST {{baseUrl}}/api/v1/library/4183c7fb-b3fc-4f46-b2dc-2ee80e31490a/reports
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reason": "Off-topic advertising link",
  "commentId": "a1b359da-11b3-4301-b794-dd039f880c5a"
}

### Content reports
GET {{baseUrl}}/api/v1/admin/reports?status=open&page=1&pageSize=20
Authorization: Bearer {{token}}

### Decide a report
POST {{baseUrl}}/api/v1/admin/reports/dacf1530-c024-4487-ae32-8b346b425348/resolve
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "action": "reject",
  "reason": "The comment was already removed by its author."
}

### Remove a publication
POST {{baseUrl}}/api/v1/admin/library/066afb47-331b-4fa8-bb7b-6ffd658d0c6e/remove
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reason": "Duplicate of an earlier publication."
}

