### Browse and search the library
GET {{baseUrl}}/api/v1/library?search=sourdough&page=1&pageSize=20

### A published recipe
GET {{baseUrl}}/api/v1/library/74712eb2-18fc-4516-97d4-af35e36c800b

### Comments of a published recipe
GET {{baseUrl}}/api/v1/library/74712eb2-18fc-4516-97d4-af35e36c800b/comments?page=1&pageSize=20
Authorization: Bearer {{token}}

### Comment a published recipe
POST {{baseUrl}}/api/v1/library/74712eb2-18fc-4516-97d4-af35e36c800b/comments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "body": "Baked it on Sunday, lovely crumb!"
}

### Withdraw an own publication
POST {{baseUrl}}/api/v1/library/74712eb2-18fc-4516-97d4-af35e36c800b/unpublish
Authorization: Bearer {{token}}

### Remove an own comment
DELETE {{baseUrl}}/api/v1/library/74712eb2-18fc-4516-97d4-af35e36c800b/comments/7051d250-9604-4f85-a6c7-4c2a143799ab
Authorization: Bearer {{token}}

### Set the own reaction
PUT {{baseUrl}}/api/v1/library/74712eb2-18fc-4516-97d4-af35e36c800b/reactions/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reaction": "want_to_bake"
}

### Remove the own reaction
DELETE {{baseUrl}}/api/v1/library/74712eb2-18fc-4516-97d4-af35e36c800b/reactions/me
Authorization: Bearer {{token}}

### Copy a published recipe into the own workspace
POST {{baseUrl}}/api/v1/library/74712eb2-18fc-4516-97d4-af35e36c800b/copy
Authorization: Bearer {{token}}

### Report a publication or a comment
POST {{baseUrl}}/api/v1/library/74712eb2-18fc-4516-97d4-af35e36c800b/reports
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reason": "Off-topic advertising link",
  "commentId": "7051d250-9604-4f85-a6c7-4c2a143799ab"
}

### Content reports
GET {{baseUrl}}/api/v1/admin/reports?status=open&page=1&pageSize=20
Authorization: Bearer {{token}}

### Decide a report
POST {{baseUrl}}/api/v1/admin/reports/7a010a9f-1755-4c28-9659-128aa459bc85/resolve
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "action": "reject",
  "reason": "The comment was already removed by its author."
}

### Remove a publication
POST {{baseUrl}}/api/v1/admin/library/3a8ea035-dacb-4b8f-ae3a-74274b50d7db/remove
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reason": "Duplicate of an earlier publication."
}

