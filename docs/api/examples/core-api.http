GET {{baseUrl}}/api/v1/library/3d6e7105-8612-408a-8ce0-5020b5cd8844

### Comments of a published recipe
GET {{baseUrl}}/api/v1/library/3d6e7105-8612-408a-8ce0-5020b5cd8844/comments?page=1&pageSize=20
Authorization: Bearer {{token}}

### Comment a published recipe
POST {{baseUrl}}/api/v1/library/3d6e7105-8612-408a-8ce0-5020b5cd8844/comments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "body": "Baked it on Sunday, lovely crumb!"
}

### Withdraw an own publication
POST {{baseUrl}}/api/v1/library/3d6e7105-8612-408a-8ce0-5020b5cd8844/unpublish
Authorization: Bearer {{token}}

### Remove an own comment
DELETE {{baseUrl}}/api/v1/library/3d6e7105-8612-408a-8ce0-5020b5cd8844/comments/6c9d095e-21a5-4cd2-a5a4-55dd1bdca7f7
Authorization: Bearer {{token}}

### Set the own reaction
PUT {{baseUrl}}/api/v1/library/3d6e7105-8612-408a-8ce0-5020b5cd8844/reactions/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reaction": "want_to_bake"
}

### Remove the own reaction
DELETE {{baseUrl}}/api/v1/library/3d6e7105-8612-408a-8ce0-5020b5cd8844/reactions/me
Authorization: Bearer {{token}}

### Copy a published recipe into the own workspace
POST {{baseUrl}}/api/v1/library/3d6e7105-8612-408a-8ce0-5020b5cd8844/copy
Authorization: Bearer {{token}}

### Report a publication or a comment
POST {{baseUrl}}/api/v1/library/3d6e7105-8612-408a-8ce0-5020b5cd8844/reports
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reason": "Off-topic advertising link",
  "commentId": "6c9d095e-21a5-4cd2-a5a4-55dd1bdca7f7"
}

### Content reports
GET {{baseUrl}}/api/v1/admin/reports?status=open&page=1&pageSize=20
Authorization: Bearer {{token}}

### Decide a report
POST {{baseUrl}}/api/v1/admin/reports/c09b6bed-2249-4501-bd3c-b82c8b4b7dd8/resolve
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "action": "reject",
  "reason": "The comment was already removed by its author."
}

### Remove a publication
POST {{baseUrl}}/api/v1/admin/library/f09e306c-683d-4f39-8280-0ead8542802d/remove
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reason": "Duplicate of an earlier publication."
}

