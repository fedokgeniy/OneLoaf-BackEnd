# core-api: one typical request per operation, generated from the recorded examples.
# Base URLs: https://<domain>/core (production behind Caddy), http://localhost:5080 (local)
# Use with the VS Code REST Client or JetBrains HTTP Client; set @token to an access token from POST /api/v1/auth/login.
@baseUrl = http://localhost:5080
@token = <access token>

### Data quality warnings
GET {{baseUrl}}/api/v1/warnings
Authorization: Bearer {{token}}

### Publish a recipe to the library
POST {{baseUrl}}/api/v1/recipes/b7727976-4ac5-4d7d-bad9-57aca1d6109d/publish
Authorization: Bearer {{token}}

### Suggest oven rounds
POST {{baseUrl}}/api/v1/calculations/oven-loading
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "items": [
    {
      "recipeId": "b7727976-4ac5-4d7d-bad9-57aca1d6109d",
      "loaves": 3
    },
    {
      "recipeId": "84d2f7ec-11fd-47ad-80e2-c6e97756155d",
      "loaves": 2
    }
  ]
}

### Register a new account
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "docs.baker.f71fcafd8@example.com",
  "password": "Rye-Bread-2026!",
  "displayName": "Docs Baker"
}

### Log in and get an access token
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "docs.baker.f71fcafd8@example.com",
  "password": "Rye-Bread-2026!"
}

### Log out
POST {{baseUrl}}/api/v1/auth/logout
Authorization: Bearer {{token}}

### Get the current user's profile
GET {{baseUrl}}/api/v1/me
Authorization: Bearer {{token}}

### Delete the current account and all its data
DELETE {{baseUrl}}/api/v1/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "password": "Rye-Bread-2026!"
}

### Units of measure
GET {{baseUrl}}/api/v1/reference/units
Authorization: Bearer {{token}}

### Currencies
GET {{baseUrl}}/api/v1/reference/currencies
Authorization: Bearer {{token}}

### Stage types
GET {{baseUrl}}/api/v1/reference/stage-types
Authorization: Bearer {{token}}

### Ingredient categories
GET {{baseUrl}}/api/v1/reference/ingredient-categories
Authorization: Bearer {{token}}

### Flour types
GET {{baseUrl}}/api/v1/reference/flour-types
Authorization: Bearer {{token}}

### Get the kitchen settings
GET {{baseUrl}}/api/v1/kitchen-settings
Authorization: Bearer {{token}}

### Replace the kitchen settings
PUT {{baseUrl}}/api/v1/kitchen-settings
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ovenPowerKw": 2.5,
  "ovenCapacityLoaves": 4,
  "mixerBowlCapacityKg": 4.0,
  "electricityTariffPerKwh": 0.25,
  "packagingCostPerLoaf": 0.15,
  "lossRatePercent": 10,
  "laborRatePerHour": 12,
  "currency": "EUR",
  "timeZone": "Europe/Vilnius"
}

### List flours
GET {{baseUrl}}/api/v1/flours?page=1&pageSize=20
Authorization: Bearer {{token}}

### Create a flour
POST {{baseUrl}}/api/v1/flours
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Bread flour T550",
  "flourTypeCode": "wheat",
  "proteinPercent": 12.5,
  "grind": "fine",
  "notes": null
}

### Get a flour
GET {{baseUrl}}/api/v1/flours/091556f9-e047-41ba-a3c4-34037d3833f6
Authorization: Bearer {{token}}

### Replace a flour
PUT {{baseUrl}}/api/v1/flours/091556f9-e047-41ba-a3c4-34037d3833f6
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Bread flour T550",
  "flourTypeCode": "wheat",
  "proteinPercent": 12.8,
  "grind": "fine",
  "notes": "Local mill"
}

### Delete a flour
DELETE {{baseUrl}}/api/v1/flours/7e8001c3-2003-48d4-9193-3981ffabb4e4
Authorization: Bearer {{token}}

### List ingredients with today's price
GET {{baseUrl}}/api/v1/ingredients?category=flour&page=1&pageSize=20
Authorization: Bearer {{token}}

### Create an ingredient
POST {{baseUrl}}/api/v1/ingredients
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Bread flour",
  "categoryCode": "flour",
  "unitCode": "g",
  "flourId": "091556f9-e047-41ba-a3c4-34037d3833f6"
}

### Get an ingredient
GET {{baseUrl}}/api/v1/ingredients/180012fa-8da7-4292-baae-b071aea57ec4
Authorization: Bearer {{token}}

### Replace an ingredient
PUT {{baseUrl}}/api/v1/ingredients/180012fa-8da7-4292-baae-b071aea57ec4
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Sea salt",
  "categoryCode": "salt",
  "unitCode": "g",
  "flourId": null
}

### Delete an ingredient
DELETE {{baseUrl}}/api/v1/ingredients/77a86713-a6ae-4c6e-8303-64f2abea4439
Authorization: Bearer {{token}}

### Price history
GET {{baseUrl}}/api/v1/ingredients/f2a4c8d9-547a-4da7-bf63-07f14c020a27/prices
Authorization: Bearer {{token}}

### Add a price with an effective date
POST {{baseUrl}}/api/v1/ingredients/f2a4c8d9-547a-4da7-bf63-07f14c020a27/prices
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "price": 1.20,
  "perQuantity": 1000,
  "currency": "EUR",
  "effectiveFrom": "2026-10-24"
}

### List recipes
GET {{baseUrl}}/api/v1/recipes?search=country&page=1&pageSize=20
Authorization: Bearer {{token}}

### Create a recipe with ingredients and stages
POST {{baseUrl}}/api/v1/recipes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Country sourdough",
  "description": "Open crumb, crisp crust.",
  "yieldLoaves": 1,
  "loafWeightG": 900,
  "notes": null,
  "ingredients": [
    {
      "ingredientId": "f2a4c8d9-547a-4da7-bf63-07f14c020a27",
      "quantity": 500
    },
    {
      "ingredientId": "c988c3b7-4463-4474-895b-255438fb664d",
      "quantity": 350
    },
    {
      "ingredientId": "180012fa-8da7-4292-baae-b071aea57ec4",
      "quantity": 10
    },
    {
      "ingredientId": "9de3b3a4-f7ea-4bb2-9563-88df35b267d3",
      "quantity": 100
    }
  ],
  "stages": [
    {
      "name": "Mix",
      "stageTypeCode": "mix",
      "minDurationMinutes": 15,
      "maxDurationMinutes": 20,
      "activeMinutes": 15
    },
    {
      "name": "Bulk fermentation",
      "stageTypeCode": "bulk_fermentation",
      "minDurationMinutes": 240,
      "maxDurationMinutes": 300,
      "temperatureC": 24
    },
    {
      "name": "Shape",
      "stageTypeCode": "shape",
      "minDurationMinutes": 10,
      "maxDurationMinutes": 15,
      "activeMinutes": 10
    },
    {
      "name": "Cold proof",
      "stageTypeCode": "proof",
      "minDurationMinutes": 600,
      "maxDurationMinutes": 720,
      "proofMode": "cold",
      "temperatureC": 4
    },
    {
      "name": "Bake",
      "stageTypeCode": "bake",
      "minDurationMinutes": 40,
      "maxDurationMinutes": 45,
      "temperatureC": 240
    }
  ]
}

### Get the effective recipe
GET {{baseUrl}}/api/v1/recipes/b7727976-4ac5-4d7d-bad9-57aca1d6109d
Authorization: Bearer {{token}}

