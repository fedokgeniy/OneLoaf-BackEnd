      "starterId": "609bbc5d-57a5-477b-a0a0-fa40d4ab50dd",
      "starterReminderMinutes": 60
    }
  ]
}

### Delete a batch
DELETE {{baseUrl}}/api/v1/batches/e67c2241-7679-4a76-861f-3d837cf52d71?ingredientsUsed=false
Authorization: Bearer {{token}}

### Cancel a batch
POST {{baseUrl}}/api/v1/batches/e67c2241-7679-4a76-861f-3d837cf52d71/cancel?ingredientsUsed=false
Authorization: Bearer {{token}}

### Complete a running batch
POST {{baseUrl}}/api/v1/batches/a49536f9-1aaf-426c-b6be-bed4391c52de/complete
Authorization: Bearer {{token}}

