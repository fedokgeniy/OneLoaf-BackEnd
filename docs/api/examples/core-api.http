### Delete a recipe
DELETE {{baseUrl}}/api/v1/recipes/f536ea6f-0e05-4fc2-b7ec-5b7fc82fec33
Authorization: Bearer {{token}}

### Archive a recipe
POST {{baseUrl}}/api/v1/recipes/eeb06747-68e0-4992-99c5-4f1b6791afd4/archive
Authorization: Bearer {{token}}

### Restore an archived recipe
POST {{baseUrl}}/api/v1/recipes/eeb06747-68e0-4992-99c5-4f1b6791afd4/unarchive
Authorization: Bearer {{token}}

### Create a variant
POST {{baseUrl}}/api/v1/recipes/f536ea6f-0e05-4fc2-b7ec-5b7fc82fec33/variants
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Country sourdough, longer bulk"
}

### Compare a variant with its parent
GET {{baseUrl}}/api/v1/recipes/eeb06747-68e0-4992-99c5-4f1b6791afd4/comparison
Authorization: Bearer {{token}}

### Scale to a number of loaves
GET {{baseUrl}}/api/v1/recipes/f536ea6f-0e05-4fc2-b7ec-5b7fc82fec33/scaled?loaves=3
Authorization: Bearer {{token}}

### Cost of N loaves on a price date
GET {{baseUrl}}/api/v1/recipes/f536ea6f-0e05-4fc2-b7ec-5b7fc82fec33/cost?loaves=3
Authorization: Bearer {{token}}

### Stage timeline and ready window for a start time
GET {{baseUrl}}/api/v1/recipes/f536ea6f-0e05-4fc2-b7ec-5b7fc82fec33/timeline?start=2026-11-26T08%3A00%3A00%2B02%3A00
Authorization: Bearer {{token}}

### Start window for a desired ready time
GET {{baseUrl}}/api/v1/recipes/f536ea6f-0e05-4fc2-b7ec-5b7fc82fec33/start-window?readyAt=2026-11-27T08%3A00%3A00%2B02%3A00
Authorization: Bearer {{token}}

### Dough weight, kneading cycles and starter amount
GET {{baseUrl}}/api/v1/recipes/f536ea6f-0e05-4fc2-b7ec-5b7fc82fec33/production-figures?loaves=3
Authorization: Bearer {{token}}

### Production calendar
GET {{baseUrl}}/api/v1/batches?status=planned
Authorization: Bearer {{token}}

### Create a batch and build its plan
POST {{baseUrl}}/api/v1/batches
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Weekend bake",
  "plannedStartAt": "2026-11-26T08:00:00+02:00",
  "source": "manual",
  "items": [
    {
      "recipeId": "f536ea6f-0e05-4fc2-b7ec-5b7fc82fec33",
      "loaves": 3,
      "starterId": "e0f6ccfa-7f1e-499d-a4d8-fdd07579da80",
      "starterReminderMinutes": 60
    }
  ]
}

### Plan a batch without saving it
POST {{baseUrl}}/api/v1/batches/preview
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Weekend bake",
  "plannedStartAt": "2026-11-26T08:00:00+02:00",
  "source": "manual",
  "items": [
    {
      "recipeId": "f536ea6f-0e05-4fc2-b7ec-5b7fc82fec33",
      "loaves": 3,
      "starterId": "e0f6ccfa-7f1e-499d-a4d8-fdd07579da80",
      "starterReminderMinutes": 60
    }
  ]
}

### Get a batch with items and stages
GET {{baseUrl}}/api/v1/batches/1de1aea8-feae-4b1f-8c15-ca89b41289d2
Authorization: Bearer {{token}}

### Re-plan a planned batch
PUT {{baseUrl}}/api/v1/batches/1de1aea8-feae-4b1f-8c15-ca89b41289d2
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Weekend bake",
  "plannedStartAt": "2026-11-26T09:00:00+02:00",
  "source": "manual",
  "items": [
    {
      "recipeId": "f536ea6f-0e05-4fc2-b7ec-5b7fc82fec33",
      "loaves": 3,
      "starterId": "e0f6ccfa-7f1e-499d-a4d8-fdd07579da80",
      "starterReminderMinutes": 60
    }
  ]
}

### Delete a batch
DELETE {{baseUrl}}/api/v1/batches/e467b750-b76d-494d-91dc-8a2d40573a9a?ingredientsUsed=false
Authorization: Bearer {{token}}

### Cancel a batch
POST {{baseUrl}}/api/v1/batches/e467b750-b76d-494d-91dc-8a2d40573a9a/cancel?ingredientsUsed=false
Authorization: Bearer {{token}}

### Complete a running batch
POST {{baseUrl}}/api/v1/batches/1de1aea8-feae-4b1f-8c15-ca89b41289d2/complete
Authorization: Bearer {{token}}

### Save how the batch was baked as a recipe variant
POST {{baseUrl}}/api/v1/batches/1de1aea8-feae-4b1f-8c15-ca89b41289d2/save-as-variant
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "itemId": null,
  "title": "Country sourdough, as baked"
}

### Merged kneads of the same dough
GET {{baseUrl}}/api/v1/batches/1de1aea8-feae-4b1f-8c15-ca89b41289d2/kneading-plan
Authorization: Bearer {{token}}

### Start a stage now
POST {{baseUrl}}/api/v1/batches/1de1aea8-feae-4b1f-8c15-ca89b41289d2/stages/15903ba2-adb4-4d9b-92dc-c63e925bb381/start
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "actualTemperatureC": null,
  "note": null
}

### Complete a running stage now
POST {{baseUrl}}/api/v1/batches/1de1aea8-feae-4b1f-8c15-ca89b41289d2/stages/15903ba2-adb4-4d9b-92dc-c63e925bb381/complete
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "actualTemperatureC": 24.5,
