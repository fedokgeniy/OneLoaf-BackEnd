Authorization: Bearer {{token}}

### Store the assistant's analysis
PUT {{baseUrl}}/api/v1/bake-records/b96889e3-e70b-4e14-a45b-70e3fe132a34/analysis
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "analysis": "Bulk fermentation ended early; give the dough more time next bake."
}

### Browse and search the library
GET {{baseUrl}}/api/v1/library?search=sourdough&page=1&pageSize=20

### A published recipe
GET {{baseUrl}}/api/v1/library/2e8a953f-51ab-418a-b265-bd2152a57a6d

### Comments of a published recipe
GET {{baseUrl}}/api/v1/library/2e8a953f-51ab-418a-b265-bd2152a57a6d/comments?page=1&pageSize=20
Authorization: Bearer {{token}}

### Comment a published recipe
POST {{baseUrl}}/api/v1/library/2e8a953f-51ab-418a-b265-bd2152a57a6d/comments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "body": "Baked it on Sunday, lovely crumb!"
}

### Withdraw an own publication
POST {{baseUrl}}/api/v1/library/2e8a953f-51ab-418a-b265-bd2152a57a6d/unpublish
Authorization: Bearer {{token}}

### Remove an own comment
DELETE {{baseUrl}}/api/v1/library/2e8a953f-51ab-418a-b265-bd2152a57a6d/comments/1a41c553-21ee-4644-a4c6-8af352117bcf
Authorization: Bearer {{token}}

### Set the own reaction
PUT {{baseUrl}}/api/v1/library/2e8a953f-51ab-418a-b265-bd2152a57a6d/reactions/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reaction": "want_to_bake"
}

### Remove the own reaction
DELETE {{baseUrl}}/api/v1/library/2e8a953f-51ab-418a-b265-bd2152a57a6d/reactions/me
Authorization: Bearer {{token}}

