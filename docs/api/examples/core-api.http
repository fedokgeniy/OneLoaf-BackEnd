POST {{baseUrl}}/api/v1/batches/91fc4cd7-79a8-4d4b-9bd7-8ff4c66c21fa/stages/2d6c8131-a3c8-4e3f-95aa-dbc303f3d585/extend
Authorization: Bearer {{token}}
Content-Type: application/json

