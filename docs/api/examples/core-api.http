# core-api: one typical request per operation, generated from the recorded examples.
# Base URLs: https://<domain>/core (production behind Caddy), http://localhost:5080 (local)
# Use with the VS Code REST Client or JetBrains HTTP Client; set @token to an access token from POST /api/v1/auth/login.
@baseUrl = http://localhost:5080
@token = <access token>

### Data quality warnings
GET {{baseUrl}}/api/v1/warnings
Authorization: Bearer {{token}}

### Publish a recipe to the library
POST {{baseUrl}}/api/v1/recipes/6c9969ad-cecd-4df5-9c64-616f46e999c3/publish
Authorization: Bearer {{token}}

### Suggest oven rounds
POST {{baseUrl}}/api/v1/calculations/oven-loading
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "items": [
    {
      "recipeId": "6c9969ad-cecd-4df5-9c64-616f46e999c3",
      "loaves": 3
    },
    {
      "recipeId": "f2739fc0-46a5-4a75-b7ad-8035e0469167",
      "loaves": 2
    }
  ]
}

### Register a new account
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "docs.baker.9e18dccd6@example.com",
  "password": "Rye-Bread-2026!",
  "displayName": "Docs Baker"
}

### Log in and get an access token
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "docs.baker.9e18dccd6@example.com",
  "password": "Rye-Bread-2026!"
}

### Exchange the refresh token cookie for a new access token
POST {{baseUrl}}/api/v1/auth/refresh

### Log out
POST {{baseUrl}}/api/v1/auth/logout
Authorization: Bearer {{token}}

### Get the current user's profile
GET {{baseUrl}}/api/v1/me
Authorization: Bearer {{token}}

### Delete the current account and all its data
DELETE {{baseUrl}}/api/v1/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "password": "Rye-Bread-2026!"
}

### Units of measure
GET {{baseUrl}}/api/v1/reference/units
Authorization: Bearer {{token}}

### Currencies
GET {{baseUrl}}/api/v1/reference/currencies
Authorization: Bearer {{token}}

### Stage types
GET {{baseUrl}}/api/v1/reference/stage-types
Authorization: Bearer {{token}}

### Ingredient categories
GET {{baseUrl}}/api/v1/reference/ingredient-categories
Authorization: Bearer {{token}}

### Flour types
GET {{baseUrl}}/api/v1/reference/flour-types
Authorization: Bearer {{token}}

### Get the kitchen settings
GET {{baseUrl}}/api/v1/kitchen-settings
Authorization: Bearer {{token}}

### Replace the kitchen settings
PUT {{baseUrl}}/api/v1/kitchen-settings
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ovenPowerKw": 2.5,
  "ovenCapacityLoaves": 4,
  "mixerBowlCapacityKg": 4.0,
  "electricityTariffPerKwh": 0.25,
  "packagingCostPerLoaf": 0.15,
  "lossRatePercent": 10,
  "laborRatePerHour": 12,
  "currency": "EUR",
  "timeZone": "Europe/Vilnius"
}

### List flours
GET {{baseUrl}}/api/v1/flours?page=1&pageSize=20
Authorization: Bearer {{token}}

### Create a flour
POST {{baseUrl}}/api/v1/flours
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Bread flour T550",
  "flourTypeCode": "wheat",
  "proteinPercent": 12.5,
  "grind": "fine",
  "notes": null
}

### Get a flour
GET {{baseUrl}}/api/v1/flours/fec271fe-1480-4f5f-97f7-32d36f7fe0ac
Authorization: Bearer {{token}}

### Replace a flour
PUT {{baseUrl}}/api/v1/flours/fec271fe-1480-4f5f-97f7-32d36f7fe0ac
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Bread flour T550",
  "flourTypeCode": "wheat",
  "proteinPercent": 12.8,
  "grind": "fine",
  "notes": "Local mill"
}

### Delete a flour
DELETE {{baseUrl}}/api/v1/flours/dd2a9e93-b7aa-4bfa-8acc-843d46609f64
Authorization: Bearer {{token}}

### List ingredients with today's price
GET {{baseUrl}}/api/v1/ingredients?category=flour&page=1&pageSize=20
Authorization: Bearer {{token}}

### Create an ingredient
POST {{baseUrl}}/api/v1/ingredients
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Bread flour",
  "categoryCode": "flour",
  "unitCode": "g",
  "flourId": "fec271fe-1480-4f5f-97f7-32d36f7fe0ac"
}

### Get an ingredient
GET {{baseUrl}}/api/v1/ingredients/ef64b19f-9efd-47c7-9c3d-80678da3317b
Authorization: Bearer {{token}}

### Replace an ingredient
PUT {{baseUrl}}/api/v1/ingredients/ef64b19f-9efd-47c7-9c3d-80678da3317b
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Sea salt",
  "categoryCode": "salt",
  "unitCode": "g",
  "flourId": null
}

### Delete an ingredient
DELETE {{baseUrl}}/api/v1/ingredients/b059e6fd-ef99-4faa-9eb9-530d661a2b87
Authorization: Bearer {{token}}

### Price history
GET {{baseUrl}}/api/v1/ingredients/5fd33415-9317-4c0c-8403-7e8ff56aa4c4/prices
Authorization: Bearer {{token}}

### Add a price with an effective date
POST {{baseUrl}}/api/v1/ingredients/5fd33415-9317-4c0c-8403-7e8ff56aa4c4/prices
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "price": 1.20,
  "perQuantity": 1000,
  "currency": "EUR",
  "effectiveFrom": "2026-10-25"
}

### Replace a price
PUT {{baseUrl}}/api/v1/ingredients/53ba3533-252f-45ce-a3b2-2296da1b740f/prices/b721ad92-e05f-4fb5-bf59-155b7b5f1e16
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "price": 4.5,
  "perQuantity": 1000,
  "currency": "EUR",
  "effectiveFrom": "2026-10-25"
}

### Delete a price
DELETE {{baseUrl}}/api/v1/ingredients/53ba3533-252f-45ce-a3b2-2296da1b740f/prices/b721ad92-e05f-4fb5-bf59-155b7b5f1e16
Authorization: Bearer {{token}}

### Stock ledger of an ingredient
GET {{baseUrl}}/api/v1/ingredients/53ba3533-252f-45ce-a3b2-2296da1b740f/stock-movements?page=1&pageSize=20
Authorization: Bearer {{token}}

### Record what was bought: price and quantity
POST {{baseUrl}}/api/v1/ingredients/53ba3533-252f-45ce-a3b2-2296da1b740f/records
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "packCount": 2,
  "packSize": 250,
  "totalCost": 3.20,
  "currency": "EUR",
  "date": "2026-11-22",
  "note": "Market",
  "priceOnly": false
}

### Correct the stock to the counted quantity
POST {{baseUrl}}/api/v1/ingredients/53ba3533-252f-45ce-a3b2-2296da1b740f/stock-adjustments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "actualQuantity": 430,
  "note": "Counted the shelf"
}

### List recipes
GET {{baseUrl}}/api/v1/recipes?search=country&page=1&pageSize=20
Authorization: Bearer {{token}}

### Create a recipe with ingredients and stages
POST {{baseUrl}}/api/v1/recipes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Country sourdough",
  "description": "Open crumb, crisp crust.",
  "yieldLoaves": 1,
  "loafWeightG": 900,
  "notes": null,
  "ingredients": [
    {
      "ingredientId": "5fd33415-9317-4c0c-8403-7e8ff56aa4c4",
      "quantity": 500
    },
    {
      "ingredientId": "ca50ed21-0dbf-4835-b9f0-b0e4698bc1eb",
      "quantity": 350
    },
    {
      "ingredientId": "ef64b19f-9efd-47c7-9c3d-80678da3317b",
      "quantity": 10
    },
    {
      "ingredientId": "884a7a5a-6cff-4f92-a303-f50da641594f",
      "quantity": 100
    }
  ],
  "stages": [
    {
      "name": "Mix",
      "stageTypeCode": "mix",
      "minDurationMinutes": 15,
      "maxDurationMinutes": 20,
      "activeMinutes": 15
    },
    {
      "name": "Bulk fermentation",
      "stageTypeCode": "bulk_fermentation",
      "minDurationMinutes": 240,
      "maxDurationMinutes": 300,
      "temperatureC": 24
    },
    {
      "name": "Shape",
      "stageTypeCode": "shape",
      "minDurationMinutes": 10,
      "maxDurationMinutes": 15,
      "activeMinutes": 10
    },
    {
      "name": "Cold proof",
      "stageTypeCode": "proof",
      "minDurationMinutes": 600,
      "maxDurationMinutes": 720,
      "proofMode": "cold",
      "temperatureC": 4
    },
    {
      "name": "Bake",
      "stageTypeCode": "bake",
      "minDurationMinutes": 40,
      "maxDurationMinutes": 45,
      "temperatureC": 240
    }
  ]
}

### Create a recipe with ingredients given by name
POST {{baseUrl}}/api/v1/recipes/drafts
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Beginner sourdough",
  "description": "A simple first loaf.",
  "yieldLoaves": 1,
  "loafWeightG": 900,
  "notes": null,
  "ingredients": [
    {
      "name": "Whole wheat flour",
      "categoryCode": "flour",
      "unitCode": "g",
      "quantity": 500,
      "isOptional": false,
      "note": null
    },
    {
      "name": "Honey",
      "categoryCode": "sweetener",
      "unitCode": "g",
      "quantity": 15,
      "isOptional": true,
      "note": null
    }
  ],
  "stages": [
    {
      "name": "Mix",
      "stageTypeCode": "mix",
      "minDurationMinutes": 10,
      "maxDurationMinutes": 15
    },
    {
      "name": "Bake",
      "stageTypeCode": "bake",
      "minDurationMinutes": 40,
      "maxDurationMinutes": 45
    }
  ]
}

