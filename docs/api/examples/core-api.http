# core-api: one typical request per operation, generated from the recorded examples.
# Base URLs: https://<domain>/core (production behind Caddy), http://localhost:5080 (local)
# Use with the VS Code REST Client or JetBrains HTTP Client; set @token to an access token from POST /api/v1/auth/login.
@baseUrl = http://localhost:5080
@token = <access token>

### Data quality warnings
GET {{baseUrl}}/api/v1/warnings
Authorization: Bearer {{token}}

### Publish a recipe to the library
POST {{baseUrl}}/api/v1/recipes/f536ea6f-0e05-4fc2-b7ec-5b7fc82fec33/publish
Authorization: Bearer {{token}}

### Suggest oven rounds
POST {{baseUrl}}/api/v1/calculations/oven-loading
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "items": [
    {
      "recipeId": "f536ea6f-0e05-4fc2-b7ec-5b7fc82fec33",
      "loaves": 3
    },
    {
      "recipeId": "eeb06747-68e0-4992-99c5-4f1b6791afd4",
      "loaves": 2
    }
  ]
}

### Register a new account
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "docs.baker.eb6ca64c7@example.com",
  "password": "Rye-Bread-2026!",
  "displayName": "Docs Baker"
}

### Log in and get an access token
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "docs.baker.eb6ca64c7@example.com",
  "password": "Rye-Bread-2026!"
}

### Log out
POST {{baseUrl}}/api/v1/auth/logout
Authorization: Bearer {{token}}

### Get the current user's profile
GET {{baseUrl}}/api/v1/me
Authorization: Bearer {{token}}

### Delete the current account and all its data
DELETE {{baseUrl}}/api/v1/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "password": "Rye-Bread-2026!"
}

### Units of measure
GET {{baseUrl}}/api/v1/reference/units
Authorization: Bearer {{token}}

### Currencies
GET {{baseUrl}}/api/v1/reference/currencies
Authorization: Bearer {{token}}

### Stage types
GET {{baseUrl}}/api/v1/reference/stage-types
Authorization: Bearer {{token}}

### Ingredient categories
GET {{baseUrl}}/api/v1/reference/ingredient-categories
Authorization: Bearer {{token}}

### Flour types
GET {{baseUrl}}/api/v1/reference/flour-types
Authorization: Bearer {{token}}

### Get the kitchen settings
GET {{baseUrl}}/api/v1/kitchen-settings
Authorization: Bearer {{token}}

### Replace the kitchen settings
PUT {{baseUrl}}/api/v1/kitchen-settings
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ovenPowerKw": 2.5,
  "ovenCapacityLoaves": 4,
  "mixerBowlCapacityKg": 4.0,
  "electricityTariffPerKwh": 0.25,
  "packagingCostPerLoaf": 0.15,
  "lossRatePercent": 10,
  "laborRatePerHour": 12,
  "currency": "EUR",
  "timeZone": "Europe/Vilnius"
}

### List flours
GET {{baseUrl}}/api/v1/flours?page=1&pageSize=20
Authorization: Bearer {{token}}

### Create a flour
POST {{baseUrl}}/api/v1/flours
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Bread flour T550",
  "flourTypeCode": "wheat",
  "proteinPercent": 12.5,
  "grind": "fine",
  "notes": null
}

### Get a flour
GET {{baseUrl}}/api/v1/flours/ab7520cd-d427-4acf-882e-bf82bf81f612
Authorization: Bearer {{token}}

### Replace a flour
PUT {{baseUrl}}/api/v1/flours/ab7520cd-d427-4acf-882e-bf82bf81f612
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Bread flour T550",
  "flourTypeCode": "wheat",
  "proteinPercent": 12.8,
  "grind": "fine",
  "notes": "Local mill"
}

### Delete a flour
DELETE {{baseUrl}}/api/v1/flours/6ed89653-e2ac-4c4b-af48-d567e5137eae
Authorization: Bearer {{token}}

### List ingredients with today's price
GET {{baseUrl}}/api/v1/ingredients?category=flour&page=1&pageSize=20
Authorization: Bearer {{token}}

### Create an ingredient
POST {{baseUrl}}/api/v1/ingredients
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Bread flour",
  "categoryCode": "flour",
  "unitCode": "g",
  "flourId": "ab7520cd-d427-4acf-882e-bf82bf81f612"
}

### Get an ingredient
GET {{baseUrl}}/api/v1/ingredients/6d143075-ce04-4d4e-941d-3d42146db57e
Authorization: Bearer {{token}}

### Replace an ingredient
PUT {{baseUrl}}/api/v1/ingredients/6d143075-ce04-4d4e-941d-3d42146db57e
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Sea salt",
  "categoryCode": "salt",
  "unitCode": "g",
  "flourId": null
}

### Delete an ingredient
DELETE {{baseUrl}}/api/v1/ingredients/ce9d3fe9-33af-4b1b-a12f-bc6ec8894138
Authorization: Bearer {{token}}

### Price history
GET {{baseUrl}}/api/v1/ingredients/10c358b9-7268-404a-b141-aaf0cebfc880/prices
Authorization: Bearer {{token}}

### Add a price with an effective date
POST {{baseUrl}}/api/v1/ingredients/10c358b9-7268-404a-b141-aaf0cebfc880/prices
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "price": 1.20,
  "perQuantity": 1000,
  "currency": "EUR",
  "effectiveFrom": "2026-10-25"
}

### Replace a price
PUT {{baseUrl}}/api/v1/ingredients/625260a8-63f3-45d5-b6e9-b5d79695ae6f/prices/b7461c5c-fd3d-42e3-824f-46799eac8f95
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "price": 4.5,
  "perQuantity": 1000,
  "currency": "EUR",
  "effectiveFrom": "2026-10-25"
}

### Delete a price
DELETE {{baseUrl}}/api/v1/ingredients/625260a8-63f3-45d5-b6e9-b5d79695ae6f/prices/b7461c5c-fd3d-42e3-824f-46799eac8f95
Authorization: Bearer {{token}}

### Stock ledger of an ingredient
GET {{baseUrl}}/api/v1/ingredients/625260a8-63f3-45d5-b6e9-b5d79695ae6f/stock-movements?page=1&pageSize=20
Authorization: Bearer {{token}}

### Record a purchase
POST {{baseUrl}}/api/v1/ingredients/625260a8-63f3-45d5-b6e9-b5d79695ae6f/purchases
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "packCount": 2,
  "packSize": 250,
  "totalCost": 3.20,
  "currency": "EUR",
  "purchasedOn": "2026-11-22",
  "note": "Market"
}

### Correct the stock to the counted quantity
POST {{baseUrl}}/api/v1/ingredients/625260a8-63f3-45d5-b6e9-b5d79695ae6f/stock-adjustments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "actualQuantity": 430,
  "note": "Counted the shelf"
}

### List recipes
GET {{baseUrl}}/api/v1/recipes?search=country&page=1&pageSize=20
Authorization: Bearer {{token}}

### Create a recipe with ingredients and stages
POST {{baseUrl}}/api/v1/recipes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Country sourdough",
  "description": "Open crumb, crisp crust.",
  "yieldLoaves": 1,
  "loafWeightG": 900,
  "notes": null,
  "ingredients": [
    {
      "ingredientId": "10c358b9-7268-404a-b141-aaf0cebfc880",
      "quantity": 500
    },
    {
      "ingredientId": "d0d37e1b-b474-431e-bcb7-d1c4364eb162",
      "quantity": 350
    },
    {
      "ingredientId": "6d143075-ce04-4d4e-941d-3d42146db57e",
      "quantity": 10
    },
    {
      "ingredientId": "37b13fb3-fcb2-4a9c-9ef7-bf45408a3336",
      "quantity": 100
    }
  ],
  "stages": [
    {
      "name": "Mix",
      "stageTypeCode": "mix",
      "minDurationMinutes": 15,
      "maxDurationMinutes": 20,
      "activeMinutes": 15
    },
    {
      "name": "Bulk fermentation",
      "stageTypeCode": "bulk_fermentation",
      "minDurationMinutes": 240,
      "maxDurationMinutes": 300,
      "temperatureC": 24
    },
    {
      "name": "Shape",
      "stageTypeCode": "shape",
      "minDurationMinutes": 10,
      "maxDurationMinutes": 15,
      "activeMinutes": 10
    },
    {
      "name": "Cold proof",
      "stageTypeCode": "proof",
      "minDurationMinutes": 600,
      "maxDurationMinutes": 720,
      "proofMode": "cold",
      "temperatureC": 4
    },
    {
      "name": "Bake",
      "stageTypeCode": "bake",
      "minDurationMinutes": 40,
      "maxDurationMinutes": 45,
      "temperatureC": 240
    }
  ]
}

### Create a recipe with ingredients given by name
POST {{baseUrl}}/api/v1/recipes/drafts
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Beginner sourdough",
  "description": "A simple first loaf.",
  "yieldLoaves": 1,
  "loafWeightG": 900,
  "notes": null,
  "ingredients": [
    {
      "name": "Whole wheat flour",
      "categoryCode": "flour",
      "unitCode": "g",
      "quantity": 500,
      "isOptional": false,
      "note": null
    },
    {
      "name": "Honey",
      "categoryCode": "sweetener",
      "unitCode": "g",
      "quantity": 15,
      "isOptional": true,
      "note": null
    }
  ],
  "stages": [
    {
      "name": "Mix",
      "stageTypeCode": "mix",
      "minDurationMinutes": 10,
      "maxDurationMinutes": 15
    },
    {
      "name": "Bake",
      "stageTypeCode": "bake",
      "minDurationMinutes": 40,
      "maxDurationMinutes": 45
    }
  ]
}

