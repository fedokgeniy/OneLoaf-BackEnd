DELETE {{baseUrl}}/api/v1/bake-records/b77babe6-9f9b-4dce-b844-699603e9c3c3/photos/4a639a40-81a3-413b-9ebf-3212c2e7a13e
Authorization: Bearer {{token}}

### Store the assistant's analysis
PUT {{baseUrl}}/api/v1/bake-records/b77babe6-9f9b-4dce-b844-699603e9c3c3/analysis
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "analysis": "Bulk fermentation ended early; give the dough more time next bake."
}

