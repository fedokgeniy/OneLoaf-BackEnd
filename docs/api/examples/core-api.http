### Delete a recipe
DELETE {{baseUrl}}/api/v1/recipes/b7727976-4ac5-4d7d-bad9-57aca1d6109d
Authorization: Bearer {{token}}

### Archive a recipe
POST {{baseUrl}}/api/v1/recipes/84d2f7ec-11fd-47ad-80e2-c6e97756155d/archive
Authorization: Bearer {{token}}

### Restore an archived recipe
POST {{baseUrl}}/api/v1/recipes/84d2f7ec-11fd-47ad-80e2-c6e97756155d/unarchive
Authorization: Bearer {{token}}

### Create a variant
POST {{baseUrl}}/api/v1/recipes/b7727976-4ac5-4d7d-bad9-57aca1d6109d/variants
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Country sourdough, longer bulk"
}

### Compare a variant with its parent
GET {{baseUrl}}/api/v1/recipes/84d2f7ec-11fd-47ad-80e2-c6e97756155d/comparison
Authorization: Bearer {{token}}

### Scale to a number of loaves
GET {{baseUrl}}/api/v1/recipes/b7727976-4ac5-4d7d-bad9-57aca1d6109d/scaled?loaves=3
Authorization: Bearer {{token}}

### Cost of N loaves on a price date
GET {{baseUrl}}/api/v1/recipes/b7727976-4ac5-4d7d-bad9-57aca1d6109d/cost?loaves=3
Authorization: Bearer {{token}}

### Stage timeline and ready window for a start time
GET {{baseUrl}}/api/v1/recipes/b7727976-4ac5-4d7d-bad9-57aca1d6109d/timeline?start=2026-11-25T08%3A00%3A00%2B02%3A00
Authorization: Bearer {{token}}

### Start window for a desired ready time
GET {{baseUrl}}/api/v1/recipes/b7727976-4ac5-4d7d-bad9-57aca1d6109d/start-window?readyAt=2026-11-26T08%3A00%3A00%2B02%3A00
Authorization: Bearer {{token}}

### Dough weight, kneading cycles and starter amount
GET {{baseUrl}}/api/v1/recipes/b7727976-4ac5-4d7d-bad9-57aca1d6109d/production-figures?loaves=3
Authorization: Bearer {{token}}

### Production calendar
GET {{baseUrl}}/api/v1/batches?status=planned
Authorization: Bearer {{token}}

### Create a batch and build its plan
POST {{baseUrl}}/api/v1/batches
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Weekend bake",
  "plannedStartAt": "2026-11-25T08:00:00+02:00",
  "source": "manual",
  "items": [
    {
      "recipeId": "b7727976-4ac5-4d7d-bad9-57aca1d6109d",
      "loaves": 3,
      "starterId": "1953c953-6626-48eb-bae0-29cc6d218d8b",
      "starterReminderMinutes": 60
    }
  ]
}

### Plan a batch without saving it
POST {{baseUrl}}/api/v1/batches/preview
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Weekend bake",
  "plannedStartAt": "2026-11-25T08:00:00+02:00",
  "source": "manual",
  "items": [
    {
      "recipeId": "b7727976-4ac5-4d7d-bad9-57aca1d6109d",
      "loaves": 3,
      "starterId": "1953c953-6626-48eb-bae0-29cc6d218d8b",
      "starterReminderMinutes": 60
    }
  ]
}

### Get a batch with items and stages
GET {{baseUrl}}/api/v1/batches/dcab64b0-9720-4f19-997d-b3bcd2492ddc
Authorization: Bearer {{token}}

### Re-plan a planned batch
PUT {{baseUrl}}/api/v1/batches/dcab64b0-9720-4f19-997d-b3bcd2492ddc
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Weekend bake",
  "plannedStartAt": "2026-11-25T09:00:00+02:00",
  "source": "manual",
  "items": [
    {
      "recipeId": "b7727976-4ac5-4d7d-bad9-57aca1d6109d",
      "loaves": 3,
      "starterId": "1953c953-6626-48eb-bae0-29cc6d218d8b",
      "starterReminderMinutes": 60
    }
  ]
}

### Cancel a batch
POST {{baseUrl}}/api/v1/batches/ea723662-db8b-4789-9a4e-78a43c4c2f4c/cancel
Authorization: Bearer {{token}}

### Complete a running batch
POST {{baseUrl}}/api/v1/batches/dcab64b0-9720-4f19-997d-b3bcd2492ddc/complete
Authorization: Bearer {{token}}

### Save how the batch was baked as a recipe variant
POST {{baseUrl}}/api/v1/batches/dcab64b0-9720-4f19-997d-b3bcd2492ddc/save-as-variant
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "itemId": null,
  "title": "Country sourdough, as baked"
}

### Merged kneads of the same dough
GET {{baseUrl}}/api/v1/batches/dcab64b0-9720-4f19-997d-b3bcd2492ddc/kneading-plan
Authorization: Bearer {{token}}

### Start a stage now
POST {{baseUrl}}/api/v1/batches/dcab64b0-9720-4f19-997d-b3bcd2492ddc/stages/b6531aa5-ff40-43a4-8dc6-a434586816b0/start
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "actualTemperatureC": null,
  "note": null
}

### Complete a running stage now
POST {{baseUrl}}/api/v1/batches/dcab64b0-9720-4f19-997d-b3bcd2492ddc/stages/b6531aa5-ff40-43a4-8dc6-a434586816b0/complete
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "actualTemperatureC": 24.5,
  "note": null
}

### Skip a pending stage
POST {{baseUrl}}/api/v1/batches/5635b892-0e3d-4618-ae90-f780c2d648c9/stages/3f93e2aa-fb92-48fa-ab57-10ff7d679c24/skip
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "actualTemperatureC": null,
  "note": "Baked without shaping, in a tin"
}

### Extend a stage by N minutes
POST {{baseUrl}}/api/v1/batches/5635b892-0e3d-4618-ae90-f780c2d648c9/stages/9a415737-bdd7-4a86-ad97-c978ff823502/extend
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "minutes": 30
}

### Change the planned durations for this batch only
PATCH {{baseUrl}}/api/v1/batches/5635b892-0e3d-4618-ae90-f780c2d648c9/stages/675fc545-1ea7-4edc-aa4d-effc7fa03c2e
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "plannedMinMinutes": 270,
  "plannedMaxMinutes": 330
}

### Restore the durations of the recipe stage
POST {{baseUrl}}/api/v1/batches/5635b892-0e3d-4618-ae90-f780c2d648c9/stages/675fc545-1ea7-4edc-aa4d-effc7fa03c2e/reset
Authorization: Bearer {{token}}

