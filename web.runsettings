<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage scope of the web client = the shared layer and the feature libraries (docs/frontend/testing.md); the
     host only composes pages. dotnet test tests/OneLoaf.Web.UnitTests -s web.runsettings -collect:"XPlat Code Coverage" -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[OneLoaf.Web.Shared]*,[OneLoaf.Web.Features.*]*</Include>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <ExcludeByFile>**/obj/**/*.cs,**/*.g.cs</ExcludeByFile>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
