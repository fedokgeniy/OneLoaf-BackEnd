<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- No coverlet here: coverage instrumentation injects tracker types into the inspected assemblies and would
       break the "depends on nothing" rules. Coverage is measured by the unit test projects. -->

  <ItemGroup>
    <ProjectReference Include="..\..\src\OneLoaf.Domain\OneLoaf.Domain.csproj" />
    <ProjectReference Include="..\..\src\OneLoaf.SharedKernel\OneLoaf.SharedKernel.csproj" />
    <ProjectReference Include="..\..\src\OneLoaf.ServiceDefaults\OneLoaf.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\src\Services\CoreApi\OneLoaf.CoreApi\OneLoaf.CoreApi.csproj" />
    <ProjectReference Include="..\..\src\Services\CoreApi\OneLoaf.CoreApi.Application\OneLoaf.CoreApi.Application.csproj" />
    <ProjectReference Include="..\..\src\Services\CoreApi\OneLoaf.CoreApi.Infrastructure\OneLoaf.CoreApi.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Services\Assistant\OneLoaf.Assistant\OneLoaf.Assistant.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TngTech.ArchUnitNET.xUnitV3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
