<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage scope = business logic (testing.md §2): OneLoaf.Domain and the *.Application projects.
     dotnet test OneLoaf.slnx -s coverlet.runsettings -collect:"XPlat Code Coverage" -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[OneLoaf.Domain]*,[OneLoaf.*.Application]*</Include>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <ExcludeByFile>**/obj/**/*.cs</ExcludeByFile>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
